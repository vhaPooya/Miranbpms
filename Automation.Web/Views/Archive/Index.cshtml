    Layout = "_LayoutGlass";
}

<div class="modal fade" id="secretariatModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); color: white; border: 1px solid rgba(255,255,255,0.15); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
            <div class="modal-body p-5 text-center">
                <h2 class="mb-5 fw-bold" style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);">لطفاً دبیرخانه موردنظر را انتخاب کنید</h2>
                <div class="row g-4 justify-content-center">
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 p-4 border-0 bg-white text-dark secretariat-card" onclick="selectSecretariat('دبیرخانه مرکزی')">
                            <i class="fa-solid fa-building-columns display-4 text-primary mb-3"></i>
                            <h5 class="fw-bold">دبیرخانه مرکزی</h5>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 p-4 border-0 bg-white text-dark secretariat-card" onclick="selectSecretariat('دبیرخانه مالی')">
                            <i class="fa-solid fa-coins display-4 text-warning mb-3"></i>
                            <h5 class="fw-bold">دبیرخانه مالی</h5>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 p-4 border-0 bg-white text-dark secretariat-card" onclick="selectSecretariat('دبیرخانه محرمانه')">
                            <i class="fa-solid fa-user-secret display-4 text-danger mb-3"></i>
                            <h5 class="fw-bold">دبیرخانه محرمانه</h5>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 p-4 border-0 bg-white text-dark secretariat-card" onclick="selectSecretariat('منابع انسانی')">
                            <i class="fa-solid fa-users display-4 text-success mb-3"></i>
                            <h5 class="fw-bold">منابع انسانی</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


