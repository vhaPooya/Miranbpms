@{
    ViewData["Title"] = "ثبت صادره جدید";
    Layout = "_LayoutGlass";
}

<div class="page-header">
    <h1 class="page-title">ثبت صادره جدید</h1>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i>بازگشت
        </a>
    </div>
</div>

<div class="compact-card">
    <div class="compact-card-header">
        <span><i class="bi bi-file-earmark-arrow-up me-2"></i>اطلاعات نامه صادره</span>
    </div>
    <div class="compact-card-body">
        <!-- Row 1 -->
        <div class="form-grid form-grid-4 mb-3">
            <div class="compact-input-group">
                <label class="compact-label">نوع مدرک</label>
                <select class="compact-select" id="documentType">
                    <option>نامه اداری</option>
                    <option>بخشنامه</option>
                    <option>ابلاغیه</option>
                </select>
            </div>
            <div class="compact-input-group">
                <label class="compact-label">طبقه بندی</label>
                <select class="compact-select" id="classification">
                    <option>عادی</option>
                    <option>محرمانه</option>
                    <option>خیلی محرمانه</option>
                </select>
            </div>
            <div class="compact-input-group">
                <label class="compact-label">نحوه ارسال</label>
                <select class="compact-select" id="sendMethod">
                    <option>پست</option>
                    <option>پیک</option>
                    <option>ایمیل</option>
                    <option>فکس</option>
                </select>
            </div>
            <div class="compact-input-group">
                <label class="compact-label">فوریت</label>
                <select class="compact-select" id="urgency">
                    <option>عادی</option>
                    <option>فوری</option>
                    <option>خیلی فوری</option>
                </select>
            </div>
        </div>

        <!-- Row 2 -->
        <div class="form-grid form-grid-4 mb-3">
            <div class="compact-input-group">
                <label class="compact-label">تاریخ صدور</label>
                <input type="text" class="compact-input" id="issueDate" value="@DateTime.Now.ToString("yyyy/MM/dd")">
            </div>
            <div class="compact-input-group">
                <label class="compact-label">شماره صادره</label>
                <div class="d-flex gap-1">
                    <input type="text" class="compact-input" id="outgoingNo" placeholder="---" style="flex: 1;">
                    <button class="btn btn-icon btn-outline-secondary" title="دریافت شماره جدید">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
            </div>
            <div class="compact-input-group">
                <label class="compact-label">شماره عطف</label>
                <input type="text" class="compact-input" id="referenceNo" placeholder="شماره نامه مرجع...">
            </div>
            <div class="compact-input-group">
                <label class="compact-label">امضاکننده</label>
                <input type="text" class="compact-input" id="signer" placeholder="نام امضاکننده...">
            </div>
        </div>

        <!-- Row 3: Recipient -->
        <div class="compact-input-group mb-3">
            <label class="compact-label">گیرنده</label>
            <input type="text" class="compact-input" id="recipientName" placeholder="نام گیرنده / سازمان...">
        </div>

        <!-- Row 4 -->
        <div class="form-grid mb-3" style="grid-template-columns: 3fr 1fr;">
            <div class="compact-input-group">
                <label class="compact-label">آدرس گیرنده</label>
                <input type="text" class="compact-input" id="recipientAddress" placeholder="آدرس پستی گیرنده">
            </div>
            <div class="compact-input-group">
                <label class="compact-label">کد پستی</label>
                <input type="text" class="compact-input" id="postalCode" placeholder="کد پستی...">
            </div>
        </div>

        <!-- Row 5 -->
        <div class="compact-input-group mb-3">
            <label class="compact-label">موضوع</label>
            <input type="text" class="compact-input" id="subject" placeholder="موضوع نامه...">
        </div>

        <!-- Row 6: Editor -->
        <div class="compact-input-group mb-3">
            <label class="compact-label">متن نامه</label>
            <div style="border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden;">
                <div style="background: var(--bg-hover); padding: 4px 8px; border-bottom: 1px solid var(--border-color); display: flex; gap: 6px;">
                    <button class="btn btn-icon btn-icon-sm btn-outline-secondary"><i class="bi bi-type-bold"></i></button>
                    <button class="btn btn-icon btn-icon-sm btn-outline-secondary"><i class="bi bi-type-italic"></i></button>
                    <button class="btn btn-icon btn-icon-sm btn-outline-secondary"><i class="bi bi-type-underline"></i></button>
                    <span style="width: 1px; background: var(--border-color);"></span>
                    <button class="btn btn-icon btn-icon-sm btn-outline-secondary"><i class="bi bi-list-ul"></i></button>
                    <button class="btn btn-icon btn-icon-sm btn-outline-secondary"><i class="bi bi-list-ol"></i></button>
                </div>
                <div contenteditable="true" id="editorContent" style="min-height: 150px; padding: 8px; outline: none; font-size: var(--font-base);">
                </div>
            </div>
        </div>

        <!-- Row 7: Attachments -->
        <div class="compact-input-group mb-3">
            <label class="compact-label">ضمائم</label>
            <div style="border: 1px dashed var(--border-color); border-radius: 4px; padding: 8px; display: flex; align-items: center; gap: 10px;">
                <button class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-paperclip me-1"></i>افزودن ضمیمه
                </button>
                <span class="text-muted">هیچ فایلی انتخاب نشده</span>
            </div>
        </div>

        <!-- Row 8: CC Recipients -->
        <div class="compact-input-group mb-3">
            <label class="compact-label">رونوشت</label>
            <div style="border: 1px solid var(--border-color); border-radius: 4px; padding: 8px;">
                <div class="d-flex gap-2 mb-2">
                    <input type="text" class="compact-input" id="ccRecipient" placeholder="نام گیرنده رونوشت..." style="flex: 1;">
                    <select class="compact-select" id="ccActionType" style="width: 120px;">
                        <option>جهت اطلاع</option>
                        <option>جهت اقدام</option>
                        <option>جهت پیگیری</option>
                    </select>
                    <button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div id="ccList" class="text-muted" style="font-size: var(--font-sm);">هیچ گیرنده‌ای اضافه نشده</div>
            </div>
        </div>
    </div>
    <div class="compact-card-footer">
        <button class="btn btn-outline-secondary btn-sm" onclick="window.history.back()">انصراف</button>
        <button class="btn btn-primary btn-sm" onclick="saveDocument(false)">
            <i class="bi bi-save me-1"></i>ذخیره
        </button>
        <button class="btn btn-success btn-sm" onclick="saveDocument(true)">
            <i class="bi bi-send me-1"></i>ذخیره و ارسال
        </button>
    </div>
</div>

<script>
    async function saveDocument(send = false) {
        const data = {
            documentTypeId: document.getElementById('documentType').value,
            classificationId: document.getElementById('classification').value,
            sendMethodId: document.getElementById('sendMethod').value,
            urgencyId: document.getElementById('urgency').value,
            issueDate: document.getElementById('issueDate').value,
            outgoingNumber: document.getElementById('outgoingNo').value,
            referenceNumber: document.getElementById('referenceNo').value,
            signer: document.getElementById('signer').value,
            recipientName: document.getElementById('recipientName').value,
            recipientAddress: document.getElementById('recipientAddress').value,
            postalCode: document.getElementById('postalCode').value,
            subject: document.getElementById('subject').value,
            content: document.getElementById('editorContent').innerHTML
        };

        try {
            const response = await fetch('/api/archive/outgoing/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
                alert('نامه با موفقیت ثبت شد');
                window.location.href = '/Archive';
            } else {
                alert('خطا: ' + result.error);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('خطا در ثبت نامه');
        }
    }
</script>
