@{
    ViewData["Title"] = "صندوق فکس";
    Layout = "_LayoutGlass";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0" style="font-size: 1rem;">صندوق فکس</h4>
                    <div>
                        <button type="button" class="btn btn-primary btn-sm" onclick="showSendFaxModal()" style="font-size: 0.875rem; padding: 0.375rem 0.75rem;">
                            <i class="fas fa-fax"></i> ارسال فکس
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="loadFaxes()" style="font-size: 0.875rem; padding: 0.375rem 0.75rem;">
                            <i class="fas fa-sync"></i> به‌روزرسانی
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- تب‌های صندوق ورودی و ارسال -->
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="fax-inbox-tab" data-bs-toggle="tab" data-bs-target="#fax-inbox" type="button" role="tab" onclick="loadFaxes('INCOMING')" style="font-size: 0.875rem;">
                                <i class="fas fa-inbox"></i> صندوق ورودی
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="fax-sent-tab" data-bs-toggle="tab" data-bs-target="#fax-sent" type="button" role="tab" onclick="loadFaxes('OUTGOING')" style="font-size: 0.875rem;">
                                <i class="fas fa-paper-plane"></i> صندوق ارسال
                            </button>
                        </li>
                    </ul>
                    
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="fax-inbox" role="tabpanel">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <input type="text" id="faxSearch" class="form-control form-control-sm" placeholder="جستجو در فکس‌ها..." style="font-size: 0.875rem;">
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="fax-sent" role="tabpanel">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <input type="text" id="sentFaxSearch" class="form-control form-control-sm" placeholder="جستجو در فکس‌های ارسال شده..." style="font-size: 0.875rem;">
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table id="faxesTable" class="table table-striped table-bordered table-sm" style="font-size: 0.875rem;">
                            <thead>
                                <tr>
                                    <th style="width: 30px;"><input type="checkbox" id="selectAllFaxes"></th>
                                    <th style="width: 150px;">از</th>
                                    <th style="width: 150px;">به</th>
                                    <th>فایل</th>
                                    <th style="width: 80px;">صفحات</th>
                                    <th style="width: 100px;">وضعیت</th>
                                    <th style="width: 150px;">تاریخ</th>
                                    <th style="width: 80px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal مشاهده فکس -->
<div class="modal fade" id="faxViewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="faxViewTitle" style="font-size: 1rem;">مشاهده فکس</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size: 0.875rem;">
                <div class="mb-2">
                    <strong>از:</strong> <span id="faxViewFrom"></span>
                </div>
                <div class="mb-2">
                    <strong>به:</strong> <span id="faxViewTo"></span>
                </div>
                <div class="mb-2">
                    <strong>تاریخ:</strong> <span id="faxViewDate"></span>
                </div>
                <div class="mb-2">
                    <strong>وضعیت:</strong> <span id="faxViewStatus"></span>
                </div>
                <hr>
                <div id="faxViewFile" class="border p-3" style="min-height: 200px; font-size: 0.875rem;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="font-size: 0.875rem;">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal ارسال فکس -->
<div class="modal fade" id="sendFaxModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-size: 1rem;">ارسال فکس</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size: 0.875rem;">
                <form id="sendFaxForm">
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 0.875rem;">شماره فکس گیرنده <span class="text-danger">*</span></label>
                        <input type="text" id="faxToNumber" class="form-control form-control-sm" required style="font-size: 0.875rem;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 0.875rem;">نام گیرنده</label>
                        <input type="text" id="faxToName" class="form-control form-control-sm" style="font-size: 0.875rem;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 0.875rem;">فایل <span class="text-danger">*</span></label>
                        <input type="file" id="faxFile" class="form-control form-control-sm" accept=".pdf,.tif,.tiff" required style="font-size: 0.875rem;">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="font-size: 0.875rem;">لغو</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="sendFax()" style="font-size: 0.875rem;">ارسال</button>
            </div>
        </div>
    </div>
</div>

<script>
let faxesData = [];
let currentFaxType = 'INCOMING';

$(document).ready(function() {
    loadFaxes('INCOMING');
    
    $('#faxSearch').on('input', function() {
        filterFaxes($(this).val());
    });
    
    $('#sentFaxSearch').on('input', function() {
        filterFaxes($(this).val());
    });
});

function loadFaxes(messageType = 'INCOMING') {
    currentFaxType = messageType;
    
    $.ajax({
        url: '/api/fax',
        method: 'GET',
        data: { messageType: messageType, page: 1, pageSize: 50 },
        success: function(response) {
            if (response.success) {
                faxesData = response.data;
                renderFaxesTable(faxesData);
            }
        },
        error: function() {
            showAlert('خطا در بارگذاری فکس‌ها', 'danger');
        }
    });
}

function renderFaxesTable(data) {
    const tbody = $('#faxesTable tbody');
    tbody.empty();
    
    data.forEach(fax => {
        const date = new Date(fax.sentReceivedDateTime || fax.createdDateTime).toLocaleString('fa-IR');
        const row = `
            <tr style="font-size: 0.875rem;">
                <td style="text-align: center;"><input type="checkbox" class="fax-checkbox" value="${fax.id}"></td>
                <td style="font-size: 0.8125rem;">${fax.fromFaxNumber || '-'}</td>
                <td style="font-size: 0.8125rem;">${fax.toFaxNumber}</td>
                <td style="font-size: 0.8125rem;">${fax.filePath ? fax.filePath.split('/').pop() : '-'}</td>
                <td style="text-align: center; font-size: 0.8125rem;">${fax.pageCount || '-'}</td>
                <td>
                    <span class="badge badge-sm ${getFaxStatusBadgeClass(fax.status)}" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        ${getFaxStatusText(fax.status)}
                    </span>
                </td>
                <td style="font-size: 0.8125rem;">${date}</td>
                <td style="text-align: center;">
                    <button class="btn btn-sm btn-info" onclick="viewFax('${fax.id}')" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        <i class="fas fa-eye"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.append(row);
    });
}

function filterFaxes(searchTerm) {
    const filtered = faxesData.filter(f => 
        (f.fromFaxNumber && f.fromFaxNumber.includes(searchTerm)) ||
        (f.toFaxNumber && f.toFaxNumber.includes(searchTerm)) ||
        (f.filePath && f.filePath.includes(searchTerm))
    );
    renderFaxesTable(filtered);
}

function viewFax(id) {
    $.ajax({
        url: `/api/fax/${id}`,
        method: 'GET',
        success: function(response) {
            if (response.success) {
                const fax = response.data;
                $('#faxViewTitle').text('مشاهده فکس');
                $('#faxViewFrom').text(`${fax.fromName || ''} <${fax.fromFaxNumber || '-'}>`);
                $('#faxViewTo').text(`${fax.toName || ''} <${fax.toFaxNumber}>`);
                $('#faxViewDate').text(new Date(fax.sentReceivedDateTime || fax.createdDateTime || new Date()).toLocaleString('fa-IR'));
                $('#faxViewStatus').html(`<span class="badge ${getFaxStatusBadgeClass(fax.status)}">${getFaxStatusText(fax.status)}</span>`);
                if (fax.filePath) {
                    $('#faxViewFile').html(`<a href="${fax.filePath}" target="_blank" class="btn btn-primary btn-sm">دانلود فایل</a>`);
                } else {
                    $('#faxViewFile').html('<p>فایلی موجود نیست</p>');
                }
                $('#faxViewModal').modal('show');
            }
        },
        error: function() {
            showAlert('خطا در بارگذاری فکس', 'danger');
        }
    });
}

function showSendFaxModal() {
    $('#sendFaxForm')[0].reset();
    $('#sendFaxModal').modal('show');
}

async function sendFax() {
    const toFaxNumber = $('#faxToNumber').val();
    const toName = $('#faxToName').val();
    const fileInput = document.getElementById('faxFile');
    
    if (!fileInput.files || fileInput.files.length === 0) {
        alert('لطفاً فایل را انتخاب کنید');
        return;
    }
    
    // دریافت تنظیمات پیش‌فرض
    let settingsId = null;
    try {
        const settingsRes = await fetch('/api/faxsettings');
        const settingsData = await settingsRes.json();
        if (settingsData.success && settingsData.data && settingsData.data.length > 0) {
            const defaultSetting = settingsData.data.find(s => s.isDefault) || settingsData.data[0];
            settingsId = defaultSetting.id;
        }
    } catch (error) {
        console.error('Error loading fax settings:', error);
    }
    
    if (!settingsId) {
        alert('لطفاً ابتدا تنظیمات فکس را پیکربندی کنید');
        return;
    }
    
    const formData = new FormData();
    formData.append('settingsId', settingsId);
    formData.append('toFaxNumber', toFaxNumber);
    formData.append('toName', toName || '');
    formData.append('file', fileInput.files[0]);
    
    $.ajax({
        url: '/api/fax/send',
        method: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function(response) {
            if (response.success) {
                showAlert('فکس با موفقیت ارسال شد', 'success');
                $('#sendFaxModal').modal('hide');
                loadFaxes('OUTGOING');
            } else {
                showAlert(response.error || 'خطا در ارسال فکس', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در ارسال فکس';
            showAlert(error, 'danger');
        }
    });
}

function getFaxStatusBadgeClass(status) {
    switch(status) {
        case 'SENT': return 'bg-success';
        case 'RECEIVED': return 'bg-info';
        case 'FAILED': return 'bg-danger';
        case 'PENDING': return 'bg-warning';
        default: return 'bg-secondary';
    }
}

function getFaxStatusText(status) {
    switch(status) {
        case 'SENT': return 'ارسال شده';
        case 'RECEIVED': return 'دریافت شده';
        case 'FAILED': return 'ناموفق';
        case 'PENDING': return 'در انتظار';
        default: return status;
    }
}

function showAlert(message, type) {
    const alert = `<div class="alert alert-${type} alert-dismissible fade show" role="alert" style="font-size: 0.875rem;">
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>`;
    $('.container-fluid').prepend(alert);
    setTimeout(() => $('.alert').fadeOut(), 3000);
}
</script>

