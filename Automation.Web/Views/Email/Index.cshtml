@{
    ViewData["Title"] = "صندوق ایمیل";
    Layout = "_LayoutGlass";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">صندوق ایمیل</h4>
                    <div>
                        <button type="button" class="btn btn-primary" onclick="showComposeModal()">
                            <i class="fas fa-envelope"></i> ایمیل جدید
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="loadEmails()">
                            <i class="fas fa-sync"></i> به‌روزرسانی
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- تب‌های صندوق ورودی و ارسال -->
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="inbox-tab" data-bs-toggle="tab" data-bs-target="#inbox" type="button" role="tab" onclick="loadEmails('INCOMING')">
                                <i class="fas fa-inbox"></i> صندوق ورودی
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="sent-tab" data-bs-toggle="tab" data-bs-target="#sent" type="button" role="tab" onclick="loadEmails('OUTGOING')">
                                <i class="fas fa-paper-plane"></i> صندوق ارسال
                            </button>
                        </li>
                    </ul>
                    
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="inbox" role="tabpanel">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <input type="text" id="emailSearch" class="form-control form-control-sm" placeholder="جستجو در ایمیل‌ها..." style="font-size: 0.875rem;">
                                </div>
                                <div class="col-md-3">
                                    <select id="emailStatusFilter" class="form-select form-select-sm" onchange="loadEmails('INCOMING')" style="font-size: 0.875rem;">
                                        <option value="">همه وضعیت‌ها</option>
                                        <option value="RECEIVED">دریافت شده</option>
                                        <option value="DRAFT">پیش‌نویس</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="sent" role="tabpanel">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <input type="text" id="sentEmailSearch" class="form-control form-control-sm" placeholder="جستجو در ایمیل‌های ارسال شده..." style="font-size: 0.875rem;">
                                </div>
                                <div class="col-md-3">
                                    <select id="sentStatusFilter" class="form-select form-select-sm" onchange="loadEmails('OUTGOING')" style="font-size: 0.875rem;">
                                        <option value="">همه وضعیت‌ها</option>
                                        <option value="SENT">ارسال شده</option>
                                        <option value="FAILED">ناموفق</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="emailsTable" class="table table-striped table-bordered table-sm" style="font-size: 0.875rem;">
                            <thead>
                                <tr>
                                    <th style="width: 30px;"><input type="checkbox" id="selectAll"></th>
                                    <th style="width: 200px;">از</th>
                                    <th style="width: 200px;">به</th>
                                    <th>موضوع</th>
                                    <th style="width: 100px;">وضعیت</th>
                                    <th style="width: 150px;">تاریخ</th>
                                    <th style="width: 80px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal مشاهده ایمیل -->
<div class="modal fade" id="emailViewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="emailViewSubject">مشاهده ایمیل</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <strong>از:</strong> <span id="emailViewFrom"></span>
                </div>
                <div class="mb-3">
                    <strong>به:</strong> <span id="emailViewTo"></span>
                </div>
                <div class="mb-3">
                    <strong>تاریخ:</strong> <span id="emailViewDate"></span>
                </div>
                <hr>
                <div id="emailViewBody" class="border p-3" style="min-height: 200px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal ارسال ایمیل -->
<div class="modal fade" id="composeEmailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ایمیل جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="composeEmailForm">
                    <div class="mb-3">
                        <label class="form-label">به <span class="text-danger">*</span></label>
                        <input type="email" id="composeTo" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">موضوع <span class="text-danger">*</span></label>
                        <input type="text" id="composeSubject" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">محتوا <span class="text-danger">*</span></label>
                        <textarea id="composeBody" class="form-control" rows="10" required></textarea>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" id="composeIsHtml" class="form-check-input">
                        <label class="form-check-label" for="composeIsHtml">HTML</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">لغو</button>
                <button type="button" class="btn btn-primary" onclick="sendEmail()">ارسال</button>
            </div>
        </div>
    </div>
</div>

<script>
let emailsData = [];

let currentEmailType = 'INCOMING';

$(document).ready(function() {
    loadEmails('INCOMING');
    
    $('#emailSearch').on('input', function() {
        filterEmails($(this).val());
    });
    
    $('#sentEmailSearch').on('input', function() {
        filterEmails($(this).val());
    });
});

function loadEmails(messageType = 'INCOMING') {
    currentEmailType = messageType;
    
    $.ajax({
        url: '/api/email',
        method: 'GET',
        data: { 
            messageType: messageType, 
            page: 1, 
            pageSize: 50,
            status: messageType === 'INCOMING' ? $('#emailStatusFilter').val() : $('#sentStatusFilter').val()
        },
        success: function(response) {
            if (response.success) {
                emailsData = response.data;
                renderEmailsTable(emailsData);
            }
        },
        error: function() {
            showAlert('خطا در بارگذاری ایمیل‌ها', 'danger');
        }
    });
}

function renderEmailsTable(data) {
    const tbody = $('#emailsTable tbody');
    tbody.empty();
    
    data.forEach(email => {
        const date = new Date(email.sentReceivedDateTime || email.createdDateTime).toLocaleString('fa-IR');
        const row = `
            <tr style="font-size: 0.875rem;">
                <td style="text-align: center;"><input type="checkbox" class="email-checkbox" value="${email.id}"></td>
                <td style="font-size: 0.8125rem;">${email.fromEmail}</td>
                <td style="font-size: 0.8125rem;">${email.toEmail}</td>
                <td style="font-size: 0.8125rem;">${email.subject}</td>
                <td>
                    <span class="badge badge-sm ${getStatusBadgeClass(email.status)}" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        ${getStatusText(email.status)}
                    </span>
                </td>
                <td style="font-size: 0.8125rem;">${date}</td>
                <td style="text-align: center;">
                    <button class="btn btn-sm btn-info" onclick="viewEmail('${email.id}')" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        <i class="fas fa-eye"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.append(row);
    });
}

function filterEmails(searchTerm) {
    const filtered = emailsData.filter(e => 
        e.subject.toLowerCase().includes(searchTerm.toLowerCase()) ||
        e.fromEmail.toLowerCase().includes(searchTerm.toLowerCase()) ||
        e.toEmail.toLowerCase().includes(searchTerm.toLowerCase())
    );
    renderEmailsTable(filtered);
}

function viewEmail(id) {
    $.ajax({
        url: `/api/email/${id}`,
        method: 'GET',
        success: function(response) {
            if (response.success) {
                const email = response.data;
                $('#emailViewSubject').text(email.subject);
                $('#emailViewFrom').text(`${email.fromName || ''} <${email.fromEmail}>`);
                $('#emailViewTo').text(`${email.toName || ''} <${email.toEmail}>`);
                $('#emailViewDate').text(new Date(email.sentReceivedDateTime || email.creationDate || new Date()).toLocaleString('fa-IR'));
                $('#emailViewBody').html(email.isHtml ? email.body : email.body.replace(/\n/g, '<br>'));
                $('#emailViewModal').modal('show');
            }
        },
        error: function() {
            showAlert('خطا در بارگذاری ایمیل', 'danger');
        }
    });
}

function showComposeModal() {
    $('#composeEmailForm')[0].reset();
    $('#composeEmailModal').modal('show');
}

async function sendEmail() {
    // دریافت تنظیمات پیش‌فرض
    let settingsId = null;
    try {
        const settingsRes = await fetch('/api/emailsettings');
        const settingsData = await settingsRes.json();
        if (settingsData.success && settingsData.data && settingsData.data.length > 0) {
            const defaultSetting = settingsData.data.find(s => s.isDefault) || settingsData.data[0];
            settingsId = defaultSetting.id;
        }
    } catch (error) {
        console.error('Error loading email settings:', error);
    }
    
    if (!settingsId) {
        alert('لطفاً ابتدا تنظیمات ایمیل را پیکربندی کنید');
        return;
    }
    
    const data = {
        settingsId: settingsId,
        toEmail: $('#composeTo').val(),
        subject: $('#composeSubject').val(),
        body: $('#composeBody').val(),
        isHtml: $('#composeIsHtml').is(':checked')
    };
    
    $.ajax({
        url: '/api/email/send',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function(response) {
            if (response.success) {
                showAlert('ایمیل با موفقیت ارسال شد', 'success');
                $('#composeEmailModal').modal('hide');
                loadEmails();
            } else {
                showAlert(response.error || 'خطا در ارسال ایمیل', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در ارسال ایمیل';
            showAlert(error, 'danger');
        }
    });
}

function getStatusBadgeClass(status) {
    switch(status) {
        case 'SENT': return 'bg-success';
        case 'RECEIVED': return 'bg-info';
        case 'FAILED': return 'bg-danger';
        case 'DRAFT': return 'bg-secondary';
        default: return 'bg-warning';
    }
}

function getStatusText(status) {
    switch(status) {
        case 'SENT': return 'ارسال شده';
        case 'RECEIVED': return 'دریافت شده';
        case 'FAILED': return 'ناموفق';
        case 'DRAFT': return 'پیش‌نویس';
        default: return status;
    }
}

function showAlert(message, type) {
    const alert = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>`;
    $('.container-fluid').prepend(alert);
    setTimeout(() => $('.alert').fadeOut(), 3000);
}
</script>

