@* Partial View: سمت های سازمانی *@

<div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
    <h5 class="fw-bold mb-0">
        <i class="fa-solid fa-sitemap me-2 text-primary"></i>
        مدیریت سمت ها (Positions)
    </h5>
    <button class="btn btn-primary btn-sm" onclick="openPositionModal()">
        <i class="fa-solid fa-plus me-1"></i>
        ایجاد سمت جدید
    </button>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border rounded-3 h-100">
            <div class="card-header bg-light py-2">
                <h6 class="mb-0 fw-semibold small">
                    <i class="fa-solid fa-diagram-project me-2 text-primary"></i>
                    ساختار سازمانی و سمت ها
                </h6>
            </div>
            <div class="card-body p-2" id="positions-tree" style="max-height: 420px; overflow-y: auto;">
                <div class="text-center py-3 text-muted small">
                    <i class="fa-solid fa-spinner fa-spin me-2"></i>در حال بارگذاری...
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small" id="positions-table-header">
                <i class="fa-solid fa-list me-1"></i>
                سمت های سطح اول
            </span>
            <span class="badge bg-secondary" id="positions-count"></span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-sm" style="font-size:0.85rem;">
                <thead class="table-light">
                <tr>
                    <th width="40">#</th>
                    <th width="90">کد</th>
                    <th>نام سمت</th>
                    <th>سازمان</th>
                    <th>واحد</th>
                    <th width="70" class="text-center">کاربران</th>
                    <th width="70" class="text-center">وضعیت</th>
                    <th width="110" class="text-center">عملیات</th>
                </tr>
                </thead>
                <tbody id="positions-tbody">
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-spinner fa-spin me-2"></i>در حال بارگذاری...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="row g-2 mt-2">
            <div class="col-md-6">
                <div class="card border rounded-3 h-100">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0 fw-semibold small"><i class="fa-solid fa-user-gear me-2 text-primary"></i>نقش های مرتبط</h6>
                    </div>
                    <div class="card-body p-2" id="position-roles" style="min-height:90px; max-height:180px; overflow-y:auto;">
                        <div class="text-muted small text-center">سمتی انتخاب نشده</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border rounded-3 h-100">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0 fw-semibold small"><i class="fa-solid fa-users me-2 text-primary"></i>کاربران مرتبط</h6>
                    </div>
                    <div class="card-body p-2" id="position-users" style="min-height:90px; max-height:180px; overflow-y:auto;">
                        <div class="text-muted small text-center">سمتی انتخاب نشده</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Position Modal -->
<div class="modal" id="positionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title" id="positionModalTitle">
                    <i class="fa-solid fa-plus me-2"></i>ایجاد سمت جدید
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small">کد سمت</label>
                        <input type="text" class="form-control form-control-sm" id="position-code" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">نام سمت</label>
                        <input type="text" class="form-control form-control-sm" id="position-name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">سازمان</label>
                        <select class="form-select form-select-sm" id="position-org"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">واحد</label>
                        <select class="form-select form-select-sm" id="position-dept"></select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small">توضیحات</label>
                        <textarea class="form-control form-control-sm" id="position-desc" rows="2"></textarea>
                    </div>
                </div>

                <div class="row g-2 mt-2">
                    <div class="col-md-6">
                        <label class="form-label small">نقش های مرتبط</label>
                        <div id="position-roles-select" class="border rounded-2 p-2" style="min-height:80px; max-height:160px; overflow-y:auto;"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">کاربران مرتبط</label>
                        <input class="form-control form-control-sm mb-2" id="position-user-search" placeholder="جستجوی کاربر..." />
                        <div id="position-users-select" class="border rounded-2 p-2" style="min-height:80px; max-height:160px; overflow-y:auto;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button class="btn btn-primary btn-sm" onclick="savePosition()">ذخیره</button>
            </div>
        </div>
    </div>
</div>

<script>
let positionsData = [];
let orgsData = [];
let selectedParentId = null;
let selectedOrgId = null;
let editingPositionId = null;
let rolesList = [];
let userSearchTimer = null;

document.addEventListener('DOMContentLoaded', function () {
    loadPositionsTree();
    loadOrganizations();
    loadRoles();
});

async function loadPositionsTree() {
    const res = await fetch('/api/settings/positions/tree');
    const json = await res.json();
    if (!json.success) return;
    orgsData = json.data.organizations || [];
    positionsData = json.data.positions || [];
    renderPositionsTree();
    await loadChildren();
}

function renderPositionsTree() {
    const container = document.getElementById('positions-tree');
    container.innerHTML = '';

    if (!orgsData.length) {
        container.innerHTML = '<div class="text-muted small text-center">سازمانی ثبت نشده</div>';
        return;
    }

    const ul = document.createElement('ul');
    ul.className = 'list-unstyled mb-0';

    orgsData.forEach(org => {
        const li = document.createElement('li');
        li.className = 'mb-2';
        li.innerHTML = `<div class="fw-semibold small" style="cursor:pointer;" onclick="selectOrg(${org.id})"><i class="fa-solid fa-building me-1 text-primary"></i>${org.organizationName}</div>`;
        const children = buildPositionTree(org.id, null);
        if (children.length) {
            const inner = document.createElement('ul');
            inner.className = 'list-unstyled ms-3 mt-1';
            children.forEach(c => inner.appendChild(c));
            li.appendChild(inner);
        }
        ul.appendChild(li);
    });

    container.appendChild(ul);
}

function buildPositionTree(orgId, parentId) {
    return positionsData
        .filter(p => p.organizationId === orgId && p.parentPositionId === parentId)
        .map(p => {
            const li = document.createElement('li');
            li.className = 'mb-1';
            li.innerHTML = `<span class="small" style="cursor:pointer;" onclick="selectParent(${p.id})"><i class="fa-solid fa-user-tie me-1 text-secondary"></i>${p.positionName}</span>`;
            const children = buildPositionTree(orgId, p.id);
            if (children.length) {
                const inner = document.createElement('ul');
                inner.className = 'list-unstyled ms-3 mt-1';
                children.forEach(c => inner.appendChild(c));
                li.appendChild(inner);
            }
            return li;
        });
}

function selectOrg(orgId) {
    selectedOrgId = orgId;
    selectedParentId = null;
    document.getElementById('positions-table-header').innerText = 'سمت های سطح اول سازمان';
    loadChildren();
}

function selectParent(parentId) {
    selectedParentId = parentId;
    selectedOrgId = null;
    document.getElementById('positions-table-header').innerText = 'زیرمجموعه های سمت انتخابی';
    loadChildren();
}

async function loadChildren() {
    const qs = selectedParentId ? `parentId=${selectedParentId}` : (selectedOrgId ? `orgId=${selectedOrgId}` : '');
    const res = await fetch(`/api/settings/positions/children${qs ? `?${qs}` : ''}`);
    const json = await res.json();
    if (!json.success) return;
    const list = json.data || [];
    document.getElementById('positions-count').innerText = list.length;

    const tbody = document.getElementById('positions-tbody');
    if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">موردی یافت نشد</td></tr>';
        return;
    }

    tbody.innerHTML = list.map((p, i) => `
        <tr onclick="showPositionDetails(${p.id})" style="cursor:pointer;">
            <td>${i + 1}</td>
            <td>${p.positionCode || ''}</td>
            <td>${p.positionName || ''}</td>
            <td>${p.organizationName || ''}</td>
            <td>${p.departmentName || ''}</td>
            <td class="text-center"><span class="badge bg-light text-dark">${p.userCount || 0}</span></td>
            <td class="text-center">${p.isActive ? '<span class="badge bg-success">فعال</span>' : '<span class="badge bg-secondary">غیرفعال</span>'}</td>
            <td class="text-center">
                <button class="btn btn-outline-primary btn-xs" onclick="event.stopPropagation(); editPosition(${p.id})"><i class="fa-solid fa-pen"></i></button>
                <button class="btn btn-outline-danger btn-xs" onclick="event.stopPropagation(); deletePosition(${p.id})"><i class="fa-solid fa-trash"></i></button>
            </td>
        </tr>
    `).join('');
}

async function showPositionDetails(id) {
    const res = await fetch(`/api/settings/positions/${id}`);
    const json = await res.json();
    if (!json.success) return;
    const p = json.data;

    const rolesWrap = document.getElementById('position-roles');
    const usersWrap = document.getElementById('position-users');

    if (p.roles && p.roles.length) {
        rolesWrap.innerHTML = p.roles.map(r => `<span class="badge bg-light text-dark me-1 mb-1">${r.roleName}</span>`).join('');
    } else {
        rolesWrap.innerHTML = '<div class="text-muted small text-center">نقشی ثبت نشده</div>';
    }

    if (p.users && p.users.length) {
        usersWrap.innerHTML = p.users.map(u => `<span class="badge bg-light text-dark me-1 mb-1">${u.fullName}</span>`).join('');
    } else {
        usersWrap.innerHTML = '<div class="text-muted small text-center">کاربری ثبت نشده</div>';
    }
}

async function loadOrganizations() {
    const res = await fetch('/api/settings/organizations/list');
    const json = await res.json();
    if (!json.success) return;
    const sel = document.getElementById('position-org');
    sel.innerHTML = '<option value="">انتخاب سازمان...</option>' +
        json.data.map(o => `<option value="${o.id}">${o.organizationName}</option>`).join('');

    sel.addEventListener('change', () => loadDepartments(sel.value));
}

async function loadDepartments(orgId) {
    const res = await fetch(`/api/settings/departments/list${orgId ? `?organizationId=${orgId}` : ''}`);
    const json = await res.json();
    if (!json.success) return;
    const sel = document.getElementById('position-dept');
    sel.innerHTML = '<option value="">انتخاب واحد...</option>' +
        json.data.map(d => `<option value="${d.id}">${d.departmentName}</option>`).join('');
}

async function loadRoles() {
    const res = await fetch('/api/settings/roles/list');
    const json = await res.json();
    if (!json.success) return;
    rolesList = json.data || [];
    renderRolesSelect([]);
}

function renderRolesSelect(selectedIds) {
    const wrap = document.getElementById('position-roles-select');
    if (!rolesList.length) {
        wrap.innerHTML = '<div class="text-muted small text-center">نقشی ثبت نشده</div>';
        return;
    }
    wrap.innerHTML = rolesList.map(r => `
        <label class="d-flex align-items-center gap-2 small mb-1">
            <input type="checkbox" class="form-check-input" value="${r.id}" ${selectedIds.includes(r.id) ? 'checked' : ''} />
            <span>${r.roleName}</span>
        </label>
    `).join('');
}

function renderUsersSelect(users, selectedIds) {
    const wrap = document.getElementById('position-users-select');
    if (!users.length) {
        wrap.innerHTML = '<div class="text-muted small text-center">کاربری یافت نشد</div>';
        return;
    }
    wrap.innerHTML = users.map(u => `
        <label class="d-flex align-items-center gap-2 small mb-1">
            <input type="checkbox" class="form-check-input" value="${u.id}" ${selectedIds.includes(u.id) ? 'checked' : ''} />
            <span>${u.firstName} ${u.lastName}</span>
        </label>
    `).join('');
}

async function searchUsers(term, selectedIds) {
    const res = await fetch(`/api/settings/users/search?name=${encodeURIComponent(term || '')}&page=1&pageSize=30`);
    const json = await res.json();
    if (!json.success) return;
    renderUsersSelect(json.data || [], selectedIds || []);
}

function openPositionModal() {
    editingPositionId = null;
    document.getElementById('positionModalTitle').innerHTML = '<i class="fa-solid fa-plus me-2"></i>ایجاد سمت جدید';
    document.getElementById('position-code').value = '';
    document.getElementById('position-name').value = '';
    document.getElementById('position-desc').value = '';
    document.getElementById('position-org').value = selectedOrgId || '';
    document.getElementById('position-dept').value = '';
    renderRolesSelect([]);
    searchUsers('', []);

    const modal = new bootstrap.Modal(document.getElementById('positionModal'));
    modal.show();
}

async function editPosition(id) {
    const res = await fetch(`/api/settings/positions/${id}`);
    const json = await res.json();
    if (!json.success) return;
    const p = json.data;
    editingPositionId = id;

    document.getElementById('positionModalTitle').innerHTML = '<i class="fa-solid fa-pen me-2"></i>ویرایش سمت';
    document.getElementById('position-code').value = p.positionCode || '';
    document.getElementById('position-name').value = p.positionName || '';
    document.getElementById('position-desc').value = p.description || '';
    document.getElementById('position-org').value = p.organizationId || '';
    await loadDepartments(p.organizationId || null);
    document.getElementById('position-dept').value = p.departmentId || '';

    renderRolesSelect(p.roleIds || []);
    searchUsers('', p.userIds || []);

    const modal = new bootstrap.Modal(document.getElementById('positionModal'));
    modal.show();
}

async function savePosition() {
    const code = document.getElementById('position-code').value.trim();
    const name = document.getElementById('position-name').value.trim();
    if (!code || !name) {
        showToast('خطا', 'کد و نام سمت الزامی است', 'danger');
        return;
    }

    const payload = {
        positionCode: code,
        positionName: name,
        description: document.getElementById('position-desc').value.trim() || null,
        organizationId: parseInt(document.getElementById('position-org').value || '0') || null,
        departmentId: parseInt(document.getElementById('position-dept').value || '0') || null,
        parentPositionId: selectedParentId || null,
        roleIds: Array.from(document.querySelectorAll('#position-roles-select input:checked')).map(x => parseInt(x.value)),
        userIds: Array.from(document.querySelectorAll('#position-users-select input:checked')).map(x => parseInt(x.value))
    };

    const url = editingPositionId ? `/api/settings/positions/${editingPositionId}` : '/api/settings/positions';
    const method = editingPositionId ? 'PUT' : 'POST';

    const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });

    if (!res.ok) {
        const err = await res.json();
        showToast('خطا', err.error || 'خطا در ذخیره اطلاعات', 'danger');
        return;
    }

    const json = await res.json();
    if (json.success) {
        showToast('موفق', 'اطلاعات با موفقیت ذخیره شد', 'success');
        bootstrap.Modal.getInstance(document.getElementById('positionModal')).hide();
        await loadPositionsTree();
    }
}

async function deletePosition(id) {
    if (!confirm('آیا از حذف این سمت مطمئن هستید؟')) return;
    const res = await fetch(`/api/settings/positions/${id}`, { method: 'DELETE' });
    const json = await res.json();
    if (json.success) {
        showToast('موفق', 'سمت حذف شد', 'success');
        await loadPositionsTree();
    }
}

document.getElementById('position-user-search').addEventListener('input', function (e) {
    clearTimeout(userSearchTimer);
    const term = e.target.value || '';
    userSearchTimer = setTimeout(() => {
        const selectedIds = Array.from(document.querySelectorAll('#position-users-select input:checked')).map(x => parseInt(x.value));
        searchUsers(term, selectedIds);
    }, 400);
});

</script>
