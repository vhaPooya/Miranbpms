            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="font-size: 0.875rem;">لغو</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveClassification()" style="font-size: 0.875rem;">ذخیره</button>
