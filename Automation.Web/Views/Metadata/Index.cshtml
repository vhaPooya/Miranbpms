@{
    ViewData["Title"] = "پارامترهای دبیرخانه";
    Layout = "_LayoutGlass";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0" style="font-size: 1rem;">پارامترهای دبیرخانه</h4>
                </div>
                <div class="card-body">
                    <!-- تب‌ها -->
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="docTypes-tab" data-bs-toggle="tab" data-bs-target="#docTypes" type="button" role="tab" onclick="loadDocumentTypes()" style="font-size: 0.875rem;">
                                انواع مدرک
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="classifications-tab" data-bs-toggle="tab" data-bs-target="#classifications" type="button" role="tab" onclick="loadClassifications()" style="font-size: 0.875rem;">
                                طبقه‌بندی‌ها
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="receiptMethods-tab" data-bs-toggle="tab" data-bs-target="#receiptMethods" type="button" role="tab" onclick="loadReceiptMethods()" style="font-size: 0.875rem;">
                                نحوه دریافت
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="urgencies-tab" data-bs-toggle="tab" data-bs-target="#urgencies" type="button" role="tab" onclick="loadUrgencies()" style="font-size: 0.875rem;">
                                فوریت‌ها
                            </button>
                        </li>
                    </ul>
                    
                    <div class="tab-content">
                        <!-- انواع مدرک -->
                        <div class="tab-pane fade show active" id="docTypes" role="tabpanel">
                            <div class="d-flex justify-content-between mb-3">
                                <h5 style="font-size: 0.9rem;">انواع مدرک</h5>
                                <button type="button" class="btn btn-primary btn-sm" onclick="showCreateDocumentTypeModal()" style="font-size: 0.875rem;">
                                    <i class="fas fa-plus"></i> افزودن
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table id="docTypesTable" class="table table-striped table-bordered table-sm" style="font-size: 0.875rem;">
                                    <thead>
                                        <tr>
                                            <th>کد</th>
                                            <th>نام</th>
                                            <th>توضیحات</th>
                                            <th style="width: 80px;">ترتیب</th>
                                            <th style="width: 120px;">عملیات</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- طبقه‌بندی‌ها -->
                        <div class="tab-pane fade" id="classifications" role="tabpanel">
                            <div class="d-flex justify-content-between mb-3">
                                <h5 style="font-size: 0.9rem;">طبقه‌بندی‌ها</h5>
                                <button type="button" class="btn btn-primary btn-sm" onclick="showCreateClassificationModal()" style="font-size: 0.875rem;">
                                    <i class="fas fa-plus"></i> افزودن
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table id="classificationsTable" class="table table-striped table-bordered table-sm" style="font-size: 0.875rem;">
                                    <thead>
                                        <tr>
                                            <th>کد</th>
                                            <th>نام</th>
                                            <th>توضیحات</th>
                                            <th style="width: 80px;">ترتیب</th>
                                            <th style="width: 120px;">عملیات</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- نحوه دریافت -->
                        <div class="tab-pane fade" id="receiptMethods" role="tabpanel">
                            <div class="d-flex justify-content-between mb-3">
                                <h5 style="font-size: 0.9rem;">نحوه دریافت</h5>
                                <button type="button" class="btn btn-primary btn-sm" onclick="showCreateReceiptMethodModal()" style="font-size: 0.875rem;">
                                    <i class="fas fa-plus"></i> افزودن
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table id="receiptMethodsTable" class="table table-striped table-bordered table-sm" style="font-size: 0.875rem;">
                                    <thead>
                                        <tr>
                                            <th>کد</th>
                                            <th>نام</th>
                                            <th>توضیحات</th>
                                            <th style="width: 80px;">ترتیب</th>
                                            <th style="width: 120px;">عملیات</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- فوریت‌ها -->
                        <div class="tab-pane fade" id="urgencies" role="tabpanel">
                            <div class="d-flex justify-content-between mb-3">
                                <h5 style="font-size: 0.9rem;">فوریت‌ها</h5>
                                <button type="button" class="btn btn-primary btn-sm" onclick="showCreateUrgencyModal()" style="font-size: 0.875rem;">
                                    <i class="fas fa-plus"></i> افزودن
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table id="urgenciesTable" class="table table-striped table-bordered table-sm" style="font-size: 0.875rem;">
                                    <thead>
                                        <tr>
                                            <th>کد</th>
                                            <th>نام</th>
                                            <th>توضیحات</th>
                                            <th style="width: 80px;">ترتیب</th>
                                            <th style="width: 120px;">عملیات</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal انواع مدرک -->
<div class="modal fade" id="documentTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentTypeModalTitle" style="font-size: 1rem;">نوع مدرک جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size: 0.875rem;">
                <form id="documentTypeForm">
                    <input type="hidden" id="documentTypeId">
                    <div class="mb-3">
                        <label class="form-label">کد <span class="text-danger">*</span></label>
                        <input type="text" id="documentTypeCode" class="form-control form-control-sm" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">نام <span class="text-danger">*</span></label>
                        <input type="text" id="documentTypeName" class="form-control form-control-sm" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea id="documentTypeDescription" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input type="number" id="documentTypeDisplayOrder" class="form-control form-control-sm" value="0">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="font-size: 0.875rem;">لغو</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveDocumentType()" style="font-size: 0.875rem;">ذخیره</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal طبقه‌بندی -->
