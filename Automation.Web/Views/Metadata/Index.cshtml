                    </div>
                    <div class="mb-3">
                        <label class="form-label">نام <span class="text-danger">*</span></label>
                        <input type="text" id="urgencyName" class="form-control form-control-sm" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea id="urgencyDescription" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input type="number" id="urgencyDisplayOrder" class="form-control form-control-sm" value="0">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="font-size: 0.875rem;">لغو</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveUrgency()" style="font-size: 0.875rem;">ذخیره</button>
            </div>
        </div>
    </div>
</div>

<script>
// Document Types
let docTypesData = [];

function loadDocumentTypes() {
    $.ajax({
        url: '/api/metadata/document-types',
        method: 'GET',
        success: function(response) {
            if (response.success) {
                docTypesData = response.data;
                renderDocumentTypesTable(docTypesData);
            }
        }
    });
}

function renderDocumentTypesTable(data) {
    const tbody = $('#docTypesTable tbody');
    tbody.empty();
    data.forEach(item => {
        const row = `
            <tr style="font-size: 0.875rem;">
                <td style="font-size: 0.8125rem;">${item.documentTypeCode}</td>
                <td style="font-size: 0.8125rem;">${item.documentTypeName}</td>
                <td style="font-size: 0.8125rem;">${item.description || '-'}</td>
                <td style="text-align: center; font-size: 0.8125rem;">${item.displayOrder}</td>
                <td style="text-align: center;">
                    <button class="btn btn-sm btn-primary" onclick="editDocumentType('${item.id}')" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="deleteDocumentType('${item.id}')" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.append(row);
    });
}

function showCreateDocumentTypeModal() {
    $('#documentTypeModalTitle').text('نوع مدرک جدید');
    $('#documentTypeForm')[0].reset();
    $('#documentTypeId').val('');
    $('#documentTypeModal').modal('show');
}

function editDocumentType(id) {
    const item = docTypesData.find(d => d.id === id);
    if (!item) return;
    
    $('#documentTypeModalTitle').text('ویرایش نوع مدرک');
    $('#documentTypeId').val(item.id);
    $('#documentTypeCode').val(item.documentTypeCode);
    $('#documentTypeName').val(item.documentTypeName);
    $('#documentTypeDescription').val(item.description || '');
    $('#documentTypeDisplayOrder').val(item.displayOrder);
    $('#documentTypeModal').modal('show');
}

function saveDocumentType() {
    const id = $('#documentTypeId').val();
    const data = {
        documentTypeCode: $('#documentTypeCode').val(),
        documentTypeName: $('#documentTypeName').val(),
        description: $('#documentTypeDescription').val() || null,
        displayOrder: parseInt($('#documentTypeDisplayOrder').val()) || 0
    };
    
    const url = id ? `/api/metadata/document-types/${id}` : '/api/metadata/document-types';
    const method = id ? 'PUT' : 'POST';
    
    $.ajax({
        url: url,
        method: method,
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function(response) {
            if (response.success) {
                showAlert(id ? 'نوع مدرک با موفقیت به‌روزرسانی شد' : 'نوع مدرک با موفقیت ایجاد شد', 'success');
                $('#documentTypeModal').modal('hide');
                loadDocumentTypes();
            } else {
                showAlert(response.error || 'خطا در ذخیره', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در ذخیره';
            showAlert(error, 'danger');
        }
    });
}

function deleteDocumentType(id) {
    if (!confirm('آیا از حذف این نوع مدرک اطمینان دارید؟')) return;
    
    $.ajax({
        url: `/api/metadata/document-types/${id}`,
        method: 'DELETE',
        success: function(response) {
            if (response.success) {
                showAlert('نوع مدرک با موفقیت حذف شد', 'success');
                loadDocumentTypes();
            } else {
                showAlert(response.error || 'خطا در حذف', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در حذف';
            showAlert(error, 'danger');
        }
    });
}

// Classifications
let classificationsData = [];

function loadClassifications() {
