    $.ajax({
        url: url,
        method: method,
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function(response) {
            if (response.success) {
                showAlert(id ? 'نحوه دریافت با موفقیت به‌روزرسانی شد' : 'نحوه دریافت با موفقیت ایجاد شد', 'success');
                $('#receiptMethodModal').modal('hide');
                loadReceiptMethods();
            } else {
                showAlert(response.error || 'خطا در ذخیره', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در ذخیره';
            showAlert(error, 'danger');
        }
    });
}

function deleteReceiptMethod(id) {
    if (!confirm('آیا از حذف این نحوه دریافت اطمینان دارید؟')) return;
    
    $.ajax({
        url: `/api/metadata/receipt-methods/${id}`,
        method: 'DELETE',
        success: function(response) {
            if (response.success) {
                showAlert('نحوه دریافت با موفقیت حذف شد', 'success');
                loadReceiptMethods();
            } else {
                showAlert(response.error || 'خطا در حذف', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در حذف';
            showAlert(error, 'danger');
        }
    });
}

// Urgencies
let urgenciesData = [];

function loadUrgencies() {
    $.ajax({
        url: '/api/metadata/urgencies',
        method: 'GET',
        success: function(response) {
            if (response.success) {
                urgenciesData = response.data;
                renderUrgenciesTable(urgenciesData);
            }
        }
    });
}

function renderUrgenciesTable(data) {
    const tbody = $('#urgenciesTable tbody');
    tbody.empty();
    data.forEach(item => {
        const row = `
            <tr style="font-size: 0.875rem;">
                <td style="font-size: 0.8125rem;">${item.urgencyCode}</td>
                <td style="font-size: 0.8125rem;">${item.urgencyName}</td>
                <td style="font-size: 0.8125rem;">${item.description || '-'}</td>
                <td style="text-align: center; font-size: 0.8125rem;">${item.displayOrder}</td>
                <td style="text-align: center;">
                    <button class="btn btn-sm btn-primary" onclick="editUrgency('${item.id}')" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="deleteUrgency('${item.id}')" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.append(row);
    });
}

function showCreateUrgencyModal() {
    $('#urgencyModalTitle').text('فوریت جدید');
    $('#urgencyForm')[0].reset();
    $('#urgencyId').val('');
    $('#urgencyModal').modal('show');
}

function editUrgency(id) {
    const item = urgenciesData.find(u => u.id === id);
    if (!item) return;
    
    $('#urgencyModalTitle').text('ویرایش فوریت');
    $('#urgencyId').val(item.id);
    $('#urgencyCode').val(item.urgencyCode);
    $('#urgencyName').val(item.urgencyName);
    $('#urgencyDescription').val(item.description || '');
    $('#urgencyDisplayOrder').val(item.displayOrder);
    $('#urgencyModal').modal('show');
}

function saveUrgency() {
    const id = $('#urgencyId').val();
    const data = {
        urgencyCode: $('#urgencyCode').val(),
        urgencyName: $('#urgencyName').val(),
        description: $('#urgencyDescription').val() || null,
        displayOrder: parseInt($('#urgencyDisplayOrder').val()) || 0
    };
    
    const url = id ? `/api/metadata/urgencies/${id}` : '/api/metadata/urgencies';
    const method = id ? 'PUT' : 'POST';
    
    $.ajax({
        url: url,
        method: method,
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function(response) {
            if (response.success) {
                showAlert(id ? 'فوریت با موفقیت به‌روزرسانی شد' : 'فوریت با موفقیت ایجاد شد', 'success');
                $('#urgencyModal').modal('hide');
                loadUrgencies();
            } else {
                showAlert(response.error || 'خطا در ذخیره', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در ذخیره';
            showAlert(error, 'danger');
        }
    });
}

function deleteUrgency(id) {
    if (!confirm('آیا از حذف این فوریت اطمینان دارید؟')) return;
    
    $.ajax({
        url: `/api/metadata/urgencies/${id}`,
        method: 'DELETE',
        success: function(response) {
            if (response.success) {
                showAlert('فوریت با موفقیت حذف شد', 'success');
                loadUrgencies();
            } else {
                showAlert(response.error || 'خطا در حذف', 'danger');
            }
        },
        error: function(xhr) {
            const error = xhr.responseJSON?.error || 'خطا در حذف';
            showAlert(error, 'danger');
        }
    });
}

function showAlert(message, type) {
    const alert = `<div class="alert alert-${type} alert-dismissible fade show" role="alert" style="font-size: 0.875rem;">
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>`;
    $('.container-fluid').prepend(alert);
    setTimeout(() => $('.alert').fadeOut(), 3000);
}

$(document).ready(function() {
    loadDocumentTypes();
});
</script>

