<script>
$(document).ready(function() {
    // Select all checkbox
    $('#selectAll').change(function() {
        $('tbody input[type="checkbox"]').prop('checked', this.checked);
    });

    // Document preview
    $('.btn-outline-primary').click(function() {
        $('#documentPreviewModal').modal('show');
    });

    // New document
    $('#newDocumentBtn').click(function() {
        alert('ایجاد سند جدید');
    });

    // Import documents
    $('#importDocumentsBtn').click(function() {
        alert('وارد کردن اسناد');
    });

    // Export documents
    $('#exportDocumentsBtn').click(function() {
        alert('خروجی گرفتن از اسناد');
    });

    // Search
    $('#searchBtn').click(function() {
        alert('جستجو انجام شد');
    });

    // Initialize date pickers (would normally use a date picker library)
    $('#dateFrom, #dateTo').attr('type', 'date');
});
</script>