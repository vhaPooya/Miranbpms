                                <div class="card-header bg-light">
                                    <h6 class="mb-0">پیوست‌ها</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item">
                                            <i class="fas fa-file-pdf text-danger"></i> فرم مرخصی.pdf
                                            <div class="small text-muted">1.2 MB</div>
                                        </li>
                                        <li class="list-group-item">
                                            <i class="fas fa-file-word text-primary"></i> درخواست مرخصی.docx
                                            <div class="small text-muted">45 KB</div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="border rounded p-3 bg-light" style="height: 500px;">
