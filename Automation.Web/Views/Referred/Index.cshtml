@* Partial View: کارتابل ارجاعی *@
@{
    Layout = null;
}

<!-- Filters -->
<div class="card border-0 custom-shadow rounded-4 mb-3">
    <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="filter-tabs d-flex gap-2 overflow-auto pb-1 pb-md-0" id="referred-status-tabs">
            <button class="btn active" data-status="" onclick="filterReferredByStatus('', this)">
                همه <span class="badge bg-primary-subtle text-primary ms-1 rounded-pill" id="referred-total-badge">0</span>
            </button>
        </div>

        <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0">
            <div class="input-group input-group-sm" style="max-width: 220px;">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" class="form-control bg-light border-start-0" placeholder="جستجو در ارجاعات..." id="referred-search" onkeypress="if(event.key==='Enter') loadReferredData()">
            </div>
            <button class="btn btn-sm btn-light border text-secondary" onclick="loadReferredData()"><i class="fa-solid fa-sliders"></i></button>
        </div>
    </div>
</div>

<!-- Table -->
<div class="table-container">
    <div class="table-responsive" style="overflow-x: visible;">
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">ردیف</th>
                    <th class="text-center" style="width: 50px;">وضعیت</th>
                    <th class="text-center" style="width: 50px;">اولویت</th>
                    <th class="text-center" style="width: 50px;">محرمانگی</th>
                    <th>گیرنده / طرف مکاتبه</th>
                    <th>شماره نامه</th>
                    <th>موضوع</th>
                    <th>تاریخ ارجاع</th>
                    <th class="text-center" style="width: 80px;">عملیات</th>
                </tr>
            </thead>
            <tbody id="referred-tbody">
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">
                        <i class="fa-solid fa-spinner fa-spin me-2"></i>
                        در حال بارگذاری...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="p-3 d-flex justify-content-between align-items-center rounded-bottom-4 mt-2" id="referred-pagination-container" style="display: none !important;">
        <small class="text-muted" id="referred-pagination-info">نمایش 0 تا 0 از 0 ارجاع</small>
        <nav>
            <ul class="pagination pagination-sm mb-0" id="referred-pagination"></ul>
        </nav>
    </div>
</div>

<script>
    let referredCurrentPage = 1;
    let referredCurrentStatus = null;
    const referredPageSize = 10;

    // Initialize immediately (AJAX loaded)
    (function() {
        loadReferredData();
    })();

    // Load status counts
    function loadStatusCounts(counts, total) {
        const container = document.getElementById('referred-status-tabs');
        document.getElementById('referred-total-badge').textContent = total;

        // Remove existing status buttons (except the first "همه" button)
        const existingBtns = container.querySelectorAll('button[data-status]:not([data-status=""])');
        existingBtns.forEach(btn => btn.remove());

        if (counts && Object.keys(counts).length > 0) {
            for (const [status, count] of Object.entries(counts)) {
                const btn = document.createElement('button');
                btn.className = `btn ${referredCurrentStatus === status ? 'active' : ''}`;
                btn.setAttribute('data-status', status);
                btn.onclick = function() { filterReferredByStatus(status, this); };
                btn.innerHTML = `${status} <span class="badge bg-danger-subtle text-danger ms-1 rounded-pill">${count}</span>`;
                container.appendChild(btn);
            }
        }
    }

    // Filter by status
    function filterReferredByStatus(status, element) {
        referredCurrentStatus = status || null;
        referredCurrentPage = 1;

        // Update active state
        document.querySelectorAll('#referred-status-tabs .btn').forEach(btn => btn.classList.remove('active'));
        if (element) element.classList.add('active');

        loadReferredData();
    }

    // Load referred data
    async function loadReferredData(page = 1) {
        referredCurrentPage = page;
        const tbody = document.getElementById('referred-tbody');
        tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4"><i class="fa-solid fa-spinner fa-spin me-2"></i>در حال بارگذاری...</td></tr>';

        try {
            const search = document.getElementById('referred-search')?.value || '';
            let url = `/api/referred?page=${page}&pageSize=${referredPageSize}`;
            if (search) url += `&search=${encodeURIComponent(search)}`;
            if (referredCurrentStatus) url += `&status=${encodeURIComponent(referredCurrentStatus)}`;

            const response = await fetch(url);
            const result = await response.json();

            if (result.success) {
                renderReferredTable(result.data, result.totalCount);
                loadStatusCounts(result.statusCounts, result.totalCount);
            } else {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger">${result.error || 'خطا در بارگذاری'}</td></tr>`;
            }
        } catch (error) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-danger">خطا در اتصال به سرور</td></tr>';
        }
    }

    // Render referred table
    function renderReferredTable(items, totalCount) {
        const tbody = document.getElementById('referred-tbody');
        const paginationContainer = document.getElementById('referred-pagination-container');

        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">موردی یافت نشد</td></tr>';
            paginationContainer.style.display = 'none';
            return;
        }

        tbody.innerHTML = items.map((item, index) => {
            const rowNum = (referredCurrentPage - 1) * referredPageSize + index + 1;
            const envelopeClass = item.isViewed ? 'fa-regular fa-envelope-open read' : 'fa-solid fa-envelope unread';

            let priorityIcon = '<i class="fa-solid fa-bell text-secondary opacity-50" title="عادی"></i>';
            if (item.priority === 'VERY_URGENT') {
                priorityIcon = '<i class="fa-solid fa-bell priority-critical" title="خیلی فوری"></i>';
            } else if (item.priority === 'URGENT') {
                priorityIcon = '<i class="fa-solid fa-bell priority-urgent" title="فوری"></i>';
            }

            let confIcon = '<i class="fa-solid fa-lock-open text-secondary opacity-50" title="عادی"></i>';
            if (item.confidentialityLevel) {
                confIcon = `<span class="position-relative"><i class="fa-solid fa-lock conf-${item.confidentialityLevel.toLowerCase()}" title="${item.confidentialityLevel}"></i></span>`;
            }

            const referralDate = new Date(item.referralDate).toLocaleDateString('fa-IR');
            const avatarNum = rowNum % 70;

            return `
                <tr data-document-id="${item.documentId}">
                    <td class="text-center fw-bold text-secondary">${rowNum}</td>
                    <td class="text-center envelope-dropdown">
                        <div class="dropdown">
                            <i class="${envelopeClass} icon-view dropdown-toggle" data-bs-toggle="dropdown" title="${item.isViewed ? 'مشاهده شده' : 'خوانده نشده'}"></i>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small cursor-pointer" onclick="setReferredStatus(this, 'read')"><i class="fa-regular fa-envelope-open me-2 text-warning"></i>مشاهده شده</a></li>
                                <li><a class="dropdown-item small cursor-pointer" onclick="setReferredStatus(this, 'unread')"><i class="fa-solid fa-envelope me-2 text-success"></i>خوانده نشده</a></li>
                            </ul>
                        </div>
                    </td>
                    <td class="text-center">${priorityIcon}</td>
                    <td class="text-center">${confIcon}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2 user-cell">
                            <img src="https://i.pravatar.cc/150?img=${avatarNum}" alt="User" style="width: 40px; height: 40px; border-radius: 50%;">
                            <div class="user-info">
                                <h6>${item.recipientName || 'نامشخص'}</h6>
                                <small>${item.recipientDepartment || 'بدون واحد'}</small>
                            </div>
                        </div>
                    </td>
                    <td><span class="fw-bold text-dark">${item.documentNumber}</span></td>
                    <td>${item.subject}</td>
                    <td class="text-muted">${referralDate}</td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn-action" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-print me-2"></i>چاپ</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small text-danger" href="#"><i class="fa-solid fa-ban me-2"></i>انصراف</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>`;
        }).join('');

        // Update pagination
        const start = (referredCurrentPage - 1) * referredPageSize + 1;
        const end = Math.min(referredCurrentPage * referredPageSize, totalCount);
        document.getElementById('referred-pagination-info').textContent = `نمایش ${start} تا ${end} از ${totalCount} ارجاع`;

        renderReferredPagination(totalCount);
        paginationContainer.style.display = totalCount > 0 ? 'flex' : 'none';
    }

    // Render pagination
    function renderReferredPagination(totalCount) {
        const totalPages = Math.ceil(totalCount / referredPageSize);
        const pagination = document.getElementById('referred-pagination');
        let html = '';

        if (referredCurrentPage > 1) {
            html += `<li class="page-item"><a class="page-link" href="#" onclick="loadReferredData(${referredCurrentPage - 1}); return false;"><i class="fa-solid fa-chevron-right"></i></a></li>`;
        } else {
            html += `<li class="page-item disabled"><a class="page-link" href="#"><i class="fa-solid fa-chevron-right"></i></a></li>`;
        }

        for (let i = Math.max(1, referredCurrentPage - 2); i <= Math.min(referredCurrentPage + 2, totalPages); i++) {
            html += `<li class="page-item ${i === referredCurrentPage ? 'active' : ''}"><a class="page-link" href="#" onclick="loadReferredData(${i}); return false;">${i}</a></li>`;
        }

        if (referredCurrentPage < totalPages) {
            html += `<li class="page-item"><a class="page-link" href="#" onclick="loadReferredData(${referredCurrentPage + 1}); return false;"><i class="fa-solid fa-chevron-left"></i></a></li>`;
        } else {
            html += `<li class="page-item disabled"><a class="page-link" href="#"><i class="fa-solid fa-chevron-left"></i></a></li>`;
        }

        pagination.innerHTML = html;
    }

    // Set read status
    function setReferredStatus(element, status) {
        const row = element.closest('tr');
        const icon = row.querySelector('.icon-view');
        if (status === 'read') {
            icon.className = 'fa-regular fa-envelope-open icon-view read dropdown-toggle';
        } else {
            icon.className = 'fa-solid fa-envelope icon-view unread dropdown-toggle';
        }
    }
</script>
