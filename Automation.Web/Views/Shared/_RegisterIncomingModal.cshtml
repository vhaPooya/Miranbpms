@{
    ViewData["Title"] = "ثبت وارده جدید";
}

<!-- Modal ثبت وارده -->
<div class="modal-overlay" id="registerIncomingModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); backdrop-filter: blur(5px); z-index: 10000; display: none; align-items: center; justify-content: center;">
    <div class="modal-box" style="background: rgba(15, 23, 42, 0.95); border: 1px solid var(--border-light); width: 95%; max-width: 1400px; max-height: 95vh; border-radius: 20px; padding: 20px; display: flex; flex-direction: column; gap: 15px; box-shadow: 0 20px 60px rgba(0,0,0,0.6); overflow: hidden;">
        <div class="modal-header" style="font-weight: 700; font-size: 1.1rem; border-bottom: 1px solid var(--border-light); padding-bottom: 12px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
            <span>ثبت وارده جدید</span>
            <i class="fa-solid fa-xmark close-modal" style="cursor: pointer; color: var(--text-gray); font-size: 1.2rem;" onclick="closeRegisterIncomingModal()"></i>
        </div>
        
        <div class="modal-body" style="flex: 1; overflow-y: auto; padding-right: 5px;">
            <!-- قسمت بالای فرم: 2 ستون (30% و 70%) -->
            <div class="form-row-top" style="display: grid; grid-template-columns: 30% 70%; gap: 15px; margin-bottom: 15px;">
                <!-- ستون چپ: 30% -->
                <div class="left-column" style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                        <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">نوع مدرک</label>
                        <select class="form-select" id="incomingDocumentType" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                        <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">طبقه بندی</label>
                        <select class="form-select" id="incomingClassification" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                        <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">نحوه دریافت</label>
                        <select class="form-select" id="incomingReceiptMethod" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                    <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                        <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">فوریت</label>
                        <select class="form-select" id="incomingUrgency" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                </div>
                
                <!-- ستون راست: 70% -->
                <div class="right-column" style="display: flex; flex-direction: column; gap: 12px;">
                    <!-- ردیف 1: تاریخ مدرک و تاریخ وارده -->
                    <div class="form-row" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px; position: relative;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">تاریخ مدرک</label>
                            <div style="position:relative">
                                <input type="text" class="form-input" id="incomingDocumentDate" value="@DateTime.Now.ToString("yyyy/MM/dd")" style="direction:ltr; text-align:right; height: 32px; font-size: 0.8rem; padding: 0 10px 0 35px;">
                                <i class="fa-regular fa-calendar" style="position:absolute; left:10px; top:8px; color:var(--text-gray); font-size:0.85rem"></i>
                            </div>
                        </div>
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">تاریخ وارده</label>
                            <div style="position:relative">
                                <input type="text" class="form-input" id="incomingDate" value="@DateTime.Now.ToString("yyyy/MM/dd")" style="direction:ltr; text-align:right; height: 32px; font-size: 0.8rem; padding: 0 10px 0 35px;">
                                <i class="fa-regular fa-calendar" style="position:absolute; left:10px; top:8px; color:var(--text-gray); font-size:0.85rem"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ردیف 2: شماره اولیه و نحوه دریافت -->
                    <div class="form-row" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">شماره اولیه</label>
                            <input type="text" class="form-input" id="incomingInitialNumber" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                        </div>
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">نحوه دریافت</label>
                            <select class="form-select" id="incomingReceiptMethod2" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                                <option value="">انتخاب کنید...</option>
                                <option value="client">ارباب رجوع / مامور سازمان</option>
                                <option value="post">پست</option>
                                <option value="email">ایمیل</option>
                                <option value="fax">فکس</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- ردیف 3: شماره وارده و فرستنده -->
                    <div class="form-row" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">شماره وارده</label>
                            <div style="position:relative">
                                <input type="text" id="incomingNo" class="form-input" style="padding-left: 35px; height: 32px; font-size: 0.8rem; padding: 0 10px 0 35px;" placeholder="---">
                                <div class="reserve-btn" id="btnReserveIncoming" style="position: absolute; left: 5px; bottom: 3px; width: 26px; height: 26px; border-radius: 50%; background: rgba(59, 130, 246, 0.2); border: 1px solid var(--accent-blue); color: var(--accent-blue); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.3s; z-index: 5; font-size: 0.75rem;" onclick="openReserveIncomingModal()">
                                    <i class="fa-solid fa-list-ol"></i>
                                </div>
                            </div>
                        </div>
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">فرستنده</label>
                            <div style="position:relative">
                                <input type="text" class="form-input" id="incomingSenderName" placeholder="نام فرستنده را وارد کنید..." style="height: 32px; font-size: 0.8rem; padding: 0 10px 0 35px;">
                                <i class="fa-solid fa-list-ol" style="position:absolute; left:10px; top:8px; color:var(--accent-blue); font-size:0.85rem"></i>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ردیف 4: شماره همراه -->
                    <div class="form-row" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">شماره همراه</label>
                            <input type="text" class="form-input" id="incomingSenderMobile" placeholder="0912..." style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                        </div>
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <!-- فیلد خالی برای هماهنگی با تصویر -->
                        </div>
                    </div>
                    
                    <!-- ردیف 5: آدرس -->
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">آدرس</label>
                            <input type="text" class="form-input" id="incomingSenderAddress" placeholder="آدرس پستی فرستنده" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                        </div>
                    </div>
                    
                    <!-- ردیف 6: موضوع -->
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                        <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                            <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">موضوع</label>
                            <input type="text" class="form-input" id="incomingSubject" placeholder="موضوع نامه را وارد کنید..." style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 15px;">
                <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                    <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">متن نامه / اسکن</label>
                    <div class="editor-container" style="border: 1px solid var(--border-light); border-radius: 10px; background: var(--glass-input); display: flex; flex-direction: column; overflow: hidden; height: 350px;">
                        <div class="editor-toolbar" style="background: rgba(255,255,255,0.05); padding: 6px; border-bottom: 1px solid var(--border-light); display: flex; gap: 8px;">
                            <i class="fa-solid fa-bold toolbar-btn" style="color: var(--text-gray); cursor: pointer; padding: 4px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem;"></i>
                            <i class="fa-solid fa-italic toolbar-btn" style="color: var(--text-gray); cursor: pointer; padding: 4px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem;"></i>
                            <i class="fa-solid fa-underline toolbar-btn" style="color: var(--text-gray); cursor: pointer; padding: 4px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem;"></i>
                            <div style="width:1px; background:var(--border-light); margin:0 5px;"></div>
                            <i class="fa-solid fa-align-right toolbar-btn" style="color: var(--text-gray); cursor: pointer; padding: 4px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem;"></i>
                            <i class="fa-solid fa-align-center toolbar-btn" style="color: var(--text-gray); cursor: pointer; padding: 4px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem;"></i>
                            <i class="fa-solid fa-image toolbar-btn" style="color: var(--text-gray); cursor: pointer; padding: 4px; border-radius: 4px; transition: 0.2s; font-size: 0.85rem; margin-right:auto"></i>
                        </div>
                        <div class="editor-content" contenteditable="true" id="incomingEditorContent" style="flex: 1; padding: 12px; color: white; overflow-y: auto; line-height: 1.6; outline: none; font-size: 0.85rem;">
                            <p style="text-align: center; color: rgba(255,255,255,0.5); padding-top: 120px;">
                                <i class="fa-solid fa-file-image" style="font-size: 2rem; margin-bottom: 12px; display: block;"></i>
                                تصویر نامه اسکن شده یا متن را اینجا وارد کنید
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ضمائم -->
            <div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 15px;">
                <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                    <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">ضمائم</label>
                    <div class="attachment-area" style="border: 2px dashed var(--border-light); border-radius: 10px; padding: 10px 15px; display: flex; align-items: center; justify-content: space-between; background: rgba(0,0,0,0.1); min-height: 60px;">
                        <button class="btn-attachments" onclick="openAttachmentsModal('incoming')" style="background: rgba(59, 130, 246, 0.2); border: 1px solid var(--accent-blue); color: #60a5fa; padding: 8px 20px; border-radius: 8px; cursor: pointer; display: flex; display: flex; align-items: center; gap: 8px; font-size: 0.85rem; transition: 0.3s;">
                            <i class="fa-solid fa-paperclip"></i> ضمائم
                        </button>
                        <div id="incomingAttachmentsPreview" style="display: flex; gap: 10px; flex-wrap: wrap; flex: 1; margin-right: 15px;">
                            <span class="upload-text" style="color: var(--text-gray); font-size: 0.75rem;">هیچ فایلی انتخاب نشده است</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- گیرندگان (رونوشت) -->
            <div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 15px;">
                <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                    <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">گیرندگان (رونوشت)</label>
                    <div class="copies-section" style="background: rgba(0,0,0,0.15); border: 1px solid var(--border-light); border-radius: 10px; padding: 15px;">
                        <div class="copies-inputs" style="display: flex; gap: 10px; align-items: flex-end; margin-bottom: 10px;">
                            <div class="input-group" style="flex: 3; display: flex; flex-direction: column; gap: 4px;">
                                <input type="text" class="form-input" id="incomingCopyRecipientName" placeholder="نام و نام خانوادگی / سمت" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                            </div>
                            <div class="input-group" style="flex: 1; display: flex; flex-direction: column; gap: 4px;">
                                <select class="form-select" id="incomingCopyActionType" style="height: 32px; font-size: 0.8rem; padding: 0 10px;">
                                    <option>جهت اطلاع</option>
                                    <option>جهت اقدام</option>
                                    <option>جهت پیگیری</option>
                                </select>
                            </div>
                            <button class="add-copy-btn" onclick="addIncomingCopyRecipient()" style="background: var(--accent-purple); color: white; border: none; width: 38px; height: 38px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem;">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                        <div class="mini-table-wrapper" style="max-height: 120px; overflow-y: auto; border: 1px solid var(--border-light); border-radius: 8px; background: rgba(0,0,0,0.2);">
                            <table class="mini-table" style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="width: 40px; position: sticky; top: 0; background: rgba(15, 23, 42, 0.9); color: var(--text-gray); font-size: 0.75rem; padding: 8px; text-align: right; border-bottom: 1px solid var(--border-light);">ردیف</th>
                                        <th style="position: sticky; top: 0; background: rgba(15, 23, 42, 0.9); color: var(--text-gray); font-size: 0.75rem; padding: 8px; text-align: right; border-bottom: 1px solid var(--border-light);">نام و نام خانوادگی / سمت</th>
                                        <th style="position: sticky; top: 0; background: rgba(15, 23, 42, 0.9); color: var(--text-gray); font-size: 0.75rem; padding: 8px; text-align: right; border-bottom: 1px solid var(--border-light);">نوع عمل</th>
                                        <th style="width: 40px; text-align: center; position: sticky; top: 0; background: rgba(15, 23, 42, 0.9); color: var(--text-gray); font-size: 0.75rem; padding: 8px; border-bottom: 1px solid var(--border-light);">حذف</th>
                                    </tr>
                                </thead>
                                <tbody id="incomingCopiesTableBody">
                                    <tr><td colspan="4" style="text-align: center; color: var(--text-gray); font-size: 0.8rem; padding: 10px;">هیچ گیرنده‌ای اضافه نشده است</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- کلیدواژه -->
            <div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 15px;">
                <div class="input-group" style="display: flex; flex-direction: column; gap: 4px;">
                    <label class="input-label" style="font-size: 0.75rem; color: var(--text-gray); font-weight: 500;">کلیدواژه</label>
                    <div style="position: relative;">
                        <input type="text" class="form-input" id="incomingKeywords" placeholder="کلمات کلیدی را با اینتر جدا کنید..." style="height: 32px; font-size: 0.8rem; padding: 0 10px 0 35px;">
                        <i class="fa-solid fa-tag" style="position:absolute; left:10px; top:8px; color:var(--text-gray); font-size:0.85rem"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-footer" style="display: flex; gap: 10px; padding-top: 15px; border-top: 1px solid var(--border-light); flex-shrink: 0;">
            <button class="btn-large btn-save-send" onclick="saveAndSendIncoming()" style="padding: 8px 20px; font-size: 0.85rem;">ذخیره و ارسال</button>
            <button class="btn-large btn-save" onclick="saveOnlyIncoming()" style="padding: 8px 20px; font-size: 0.85rem;">ذخیره</button>
            <button class="btn-large btn-cancel" onclick="closeRegisterIncomingModal()" style="padding: 8px 20px; font-size: 0.85rem;">انصراف</button>
        </div>
    </div>
</div>

<!-- Modal شماره رزرو وارده -->
<div class="modal-overlay" id="reserveIncomingModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); z-index: 10002; display: none; align-items: center; justify-content: center;">
    <div class="modal-box" style="background: rgba(15, 23, 42, 0.95); border: 1px solid var(--border-light); width: 400px; max-height: 500px; border-radius: 15px; padding: 20px; display: flex; flex-direction: column; gap: 15px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
        <div class="modal-header" style="font-weight: 700; font-size: 1rem; border-bottom: 1px solid var(--border-light); padding-bottom: 10px; display: flex; justify-content: space-between;">
            <span>انتخاب شماره رزرو شده</span>
            <i class="fa-solid fa-xmark close-modal" style="cursor: pointer; color: var(--text-gray);" onclick="closeReserveIncomingModal()"></i>
        </div>
        <div class="reserve-list" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 5px; max-height: 300px;">
            <div class="reserve-item" style="padding: 10px; border-radius: 8px; background: rgba(255,255,255,0.05); cursor: pointer; display: flex; justify-content: space-between; font-size: 0.9rem; border: 1px solid transparent;" onclick="selectReserveIncoming(this, '۱۴۰۴/۲۰۱/۵۵۶')">
                <span>۱۴۰۴/۲۰۱/۵۵۶</span>
                <span style="font-size:0.8rem; color:var(--text-gray)">رزرو شده توسط: محمدی</span>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-large btn-save-send" style="width:100%" onclick="confirmReserveIncoming()">تایید و انتخاب</button>
        </div>
    </div>
</div>

<style>
    .form-input, .form-select {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        color: white;
        font-family: inherit;
        transition: 0.3s;
        width: 100%;
    }
    .form-input:focus, .form-select:focus {
        border-color: var(--accent-blue);
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.3);
        background: rgba(0, 0, 0, 0.5);
        outline: none;
    }
    .form-select option {
        background: #1e293b;
        color: white;
    }
    .toolbar-btn:hover {
        color: white !important;
        background: rgba(255,255,255,0.1) !important;
    }
    .reserve-item:hover {
        background: rgba(255,255,255,0.1) !important;
    }
    .reserve-item.selected {
        border-color: var(--accent-blue) !important;
        background: rgba(59, 130, 246, 0.2) !important;
    }
    .btn-attachments:hover {
        background: rgba(59, 130, 246, 0.3) !important;
        transform: translateY(-2px);
    }
    .delete-row-btn {
        color: var(--text-gray);
        cursor: pointer;
        visibility: hidden;
    }
    .mini-table tr:hover .delete-row-btn {
        visibility: visible;
    }
    .delete-row-btn:hover {
        color: #ef4444;
    }
    .mini-table td {
        padding: 6px 8px;
        font-size: 0.8rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        color: var(--text-white);
    }
</style>

<script>
    let selectedReserveIncomingValue = null;
    window.incomingAttachments = window.incomingAttachments || [];
    window.incomingFollowUps = window.incomingFollowUps || [];
    let incomingCopies = [];

    function openRegisterIncomingModal() {
        loadIncomingMetadata();
        document.getElementById('registerIncomingModal').style.display = 'flex';
    }

    function closeRegisterIncomingModal() {
        document.getElementById('registerIncomingModal').style.display = 'none';
    }

    function openReserveIncomingModal() {
        document.getElementById('reserveIncomingModal').style.display = 'flex';
    }

    function closeReserveIncomingModal() {
        document.getElementById('reserveIncomingModal').style.display = 'none';
    }

    function selectReserveIncoming(element, value) {
        document.querySelectorAll('#reserveIncomingModal .reserve-item').forEach(item => item.classList.remove('selected'));
        element.classList.add('selected');
        selectedReserveIncomingValue = value;
    }

    function confirmReserveIncoming() {
        if (selectedReserveIncomingValue) {
            document.getElementById('incomingNo').value = selectedReserveIncomingValue;
            closeReserveIncomingModal();
        }
    }

    async function loadIncomingMetadata() {
        try {
            // Load Document Types
            const docTypesRes = await fetch('/api/archive/documenttypes');
            const docTypes = await docTypesRes.json();
            const docTypeSelect = document.getElementById('incomingDocumentType');
            docTypeSelect.innerHTML = '<option value="">انتخاب کنید...</option>' + 
                docTypes.map(t => `<option value="${t.id}">${t.documentTypeName}</option>`).join('');

            // Load Classifications
            const classRes = await fetch('/api/archive/classifications');
            const classifications = await classRes.json();
            const classSelect = document.getElementById('incomingClassification');
            classSelect.innerHTML = '<option value="">انتخاب کنید...</option>' + 
                classifications.map(c => `<option value="${c.id}">${c.classificationName}</option>`).join('');

            // Load Receipt Methods
            const receiptRes = await fetch('/api/archive/receiptmethods');
            const receipts = await receiptRes.json();
            const receiptSelect = document.getElementById('incomingReceiptMethod');
            receiptSelect.innerHTML = '<option value="">انتخاب کنید...</option>' + 
                receipts.map(r => `<option value="${r.id}">${r.receiptMethodName}</option>`).join('');

            // Load Urgencies
            const urgencyRes = await fetch('/api/archive/urgencies');
            const urgencies = await urgencyRes.json();
            const urgencySelect = document.getElementById('incomingUrgency');
            urgencySelect.innerHTML = '<option value="">انتخاب کنید...</option>' + 
                urgencies.map(u => `<option value="${u.id}">${u.urgencyName}</option>`).join('');
        } catch (error) {
            console.error('Error loading metadata:', error);
        }
    }

    function addIncomingCopyRecipient() {
        const name = document.getElementById('incomingCopyRecipientName').value;
        const actionType = document.getElementById('incomingCopyActionType').value;
        
        if (!name.trim()) {
            alert('لطفا نام گیرنده را وارد کنید');
            return;
        }

        incomingCopies.push({ name, actionType });
        renderIncomingCopiesTable();
        
        document.getElementById('incomingCopyRecipientName').value = '';
        document.getElementById('incomingCopyActionType').value = 'جهت اطلاع';
    }

    function renderIncomingCopiesTable() {
        const tbody = document.getElementById('incomingCopiesTableBody');
        if (incomingCopies.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; color: var(--text-gray); font-size: 0.8rem; padding: 10px;">هیچ گیرنده‌ای اضافه نشده است</td></tr>';
            return;
        }
        
        tbody.innerHTML = incomingCopies.map((copy, index) => `
            <tr>
                <td>${index + 1}</td>
                <td>${copy.name}</td>
                <td>${copy.actionType}</td>
                <td style="text-align: center;">
                    <i class="fa-solid fa-trash-can delete-row-btn" onclick="removeIncomingCopyRecipient(${index})" style="color: var(--text-gray); cursor: pointer; visibility: visible;"></i>
                </td>
            </tr>
        `).join('');
    }

    function removeIncomingCopyRecipient(index) {
        incomingCopies.splice(index, 1);
        renderIncomingCopiesTable();
    }

    function updateIncomingAttachmentsPreview() {
        const preview = document.getElementById('incomingAttachmentsPreview');
        const allItems = [...(window.incomingAttachments || []), ...(window.incomingFollowUps || [])];
        
        if (allItems.length === 0) {
            preview.innerHTML = '<span class="upload-text" style="color: var(--text-gray); font-size: 0.75rem;">هیچ فایلی انتخاب نشده است</span>';
            return;
        }
        
        preview.innerHTML = allItems.map((item, index) => {
            const isFollowUp = item.type === 'follow-up';
            return `<div class="attachment-icon ${isFollowUp ? 'follow-up' : ''}" title="${item.description || ''}">
                <i class="fa-solid fa-${isFollowUp ? 'link' : 'paperclip'}"></i>
                <span>${item.displayName || item.fileName}</span>
            </div>`;
        }).join('');
    }

    async function saveAndSendIncoming() {
        await saveIncomingDocument(true);
    }

    async function saveOnlyIncoming() {
        await saveIncomingDocument(false);
    }

    async function saveIncomingDocument(send = false) {
        const data = {
            documentTypeId: document.getElementById('incomingDocumentType').value,
            classificationId: document.getElementById('incomingClassification').value,
            receiptMethodId: document.getElementById('incomingReceiptMethod').value,
            urgencyId: document.getElementById('incomingUrgency').value,
            documentDate: document.getElementById('incomingDocumentDate').value,
            incomingDate: document.getElementById('incomingDate').value,
            initialNumber: document.getElementById('incomingInitialNumber').value,
            incomingNumber: document.getElementById('incomingNo').value,
            senderName: document.getElementById('incomingSenderName').value,
            senderAddress: document.getElementById('incomingSenderAddress').value,
            senderMobile: document.getElementById('incomingSenderMobile').value,
            subject: document.getElementById('incomingSubject').value,
            content: document.getElementById('incomingEditorContent').innerHTML,
            keywords: document.getElementById('incomingKeywords').value,
            copies: incomingCopies,
            attachments: window.incomingAttachments || [],
            followUps: window.incomingFollowUps || [],
            send: send
        };

        try {
            const response = await fetch('/api/archive/incoming/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (result.success) {
                alert('نامه با موفقیت ثبت شد');
                closeRegisterIncomingModal();
                if (typeof window.refreshArchiveList === 'function') {
                    window.refreshArchiveList();
                }
            } else {
                alert('خطا: ' + result.error);
            }
        } catch (error) {
            console.error('Error saving document:', error);
            alert('خطا در ثبت نامه');
        }
    }

    document.getElementById('reserveIncomingModal').addEventListener('click', (e) => {
        if (e.target.id === 'reserveIncomingModal') {
            closeReserveIncomingModal();
        }
    });

    document.getElementById('registerIncomingModal').addEventListener('click', (e) => {
        if (e.target.id === 'registerIncomingModal') {
            closeRegisterIncomingModal();
        }
    });

    // Expose function globally
    window.openRegisterIncomingModal = openRegisterIncomingModal;
    window.updateIncomingAttachmentsPreview = updateIncomingAttachmentsPreview;
</script>

