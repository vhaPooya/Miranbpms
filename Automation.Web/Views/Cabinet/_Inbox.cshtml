@{
    ViewData["Title"] = "کارتابل وارده";
    Layout = "_LayoutGlass";
}

<div class="row g-3">

    <div class="col-lg-3">
        <div class="card border-0 custom-shadow rounded-4 h-100">
            <div class="card-body p-3">
                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary" style="font-size: 0.9rem;">
                    <i class="fa-solid fa-folder-tree ms-2 text-primary"></i>
                    دسته‌بندی بر اساس اقدام
                </h6>
                <div class="d-flex flex-column gap-1">
                    <a href="#" class="list-btn rounded active">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-signature"></i>
                            <span>جهت امضاء</span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill">3</span>
                    </a>
                    <a href="#" class="list-btn rounded">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-eye"></i>
                            <span>جهت استحضار</span>
                        </div>
                        <span class="badge bg-light text-secondary border rounded-pill">24</span>
                    </a>
                    <a href="#" class="list-btn rounded">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-clipboard-check"></i>
                            <span>جهت بررسی</span>
                        </div>
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill">10</span>
                    </a>
                    <a href="#" class="list-btn rounded">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-trash-arrow-up"></i>
                            <span>حذف شده‌ها</span>
                        </div>
                        <span class="badge bg-danger-subtle text-danger rounded-pill">12</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="card border-0 custom-shadow rounded-4">
            <div class="card-body p-0">

                <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white rounded-top-4">
                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 400px;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" class="form-control bg-light border-start-0" placeholder="جستجو در نامه‌ها...">
                        </div>
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 text-nowrap">
                            <i class="fa-solid fa-filter"></i> فیلتر
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-danger" title="نامه‌های مسدود شده">مسدود</button>
                        <button class="btn btn-sm btn-outline-primary active">همه</button>
                        <button class="btn btn-sm btn-light text-secondary"><i class="fa-solid fa-sliders"></i></button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 40px;">
                                    <input class="form-check-input" type="checkbox">
                                </th>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th class="text-center" style="width: 40px;"><i class="fa-regular fa-envelope"></i></th>
                                <th class="text-center" style="width: 40px;"><i class="fa-regular fa-bell"></i></th>
                                <th class="text-center" style="width: 40px;"><i class="fa-solid fa-lock"></i></th>
                                <th>شماره نامه</th>
                                <th>موضوع</th>
                                <th>فرستنده</th>
                                <th>تاریخ دریافت</th>
                                <th class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center"><input class="form-check-input" type="checkbox" checked></td>
                                <td class="text-center">
                                    <div class="attachment-pin-wrapper">
                                        1 <i class="fa-solid fa-paperclip attachment-pin"></i>
                                    </div>
                                </td>
                                <td class="text-center envelope-dropdown">
                                    <div class="dropdown">
                                        <i class="fa-solid fa-envelope envelope-icon unread dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"></i>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, true)"><i class="fa-regular fa-envelope-open me-2"></i>خوانده شده</a></li>
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, false)"><i class="fa-solid fa-envelope me-2"></i>خوانده نشده</a></li>
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center"><i class="fa-solid fa-bell text-muted opacity-50" title="عادی"></i></td>
                                <td class="text-center"><i class="fa-solid fa-lock-open text-muted opacity-50" title="عادی"></i></td>
                                <td><span class="fw-bold text-dark">۳۸۸</span></td>
                                <td>کارتابل نامه‌های واصله</td>
                                <td>اردوان دایی</td>
                                <td class="text-muted">۱۴/۰۲/۲۹</td>
                                <td class="text-center">
                                    <button class="btn-action" title="بیشتر"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                    <button class="btn-action" title="ویرایش"><i class="fa-regular fa-pen-to-square"></i></button>
                                    <button class="btn-action" title="حذف"><i class="fa-regular fa-trash-can"></i></button>
                                </td>
                            </tr>

                            <tr>
                                <td class="text-center"><input class="form-check-input" type="checkbox"></td>
                                <td class="text-center">
                                    <div class="attachment-pin-wrapper">
                                        2 <i class="fa-solid fa-paperclip attachment-pin"></i>
                                    </div>
                                </td>
                                <td class="text-center envelope-dropdown">
                                    <div class="dropdown">
                                        <i class="fa-regular fa-envelope-open envelope-icon read dropdown-toggle" data-bs-toggle="dropdown"></i>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, true)"><i class="fa-regular fa-envelope-open me-2"></i>خوانده شده</a></li>
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, false)"><i class="fa-solid fa-envelope me-2"></i>خوانده نشده</a></li>
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center"><i class="fa-solid fa-bell prio-immediate" title="فوری"></i></td>
                                <td class="text-center"><i class="fa-solid fa-lock conf-confidential" title="محرمانه"></i></td>
                                <td><span class="fw-bold text-dark">۱۱۴۷۷۶۷</span></td>
                                <td>مستندات پروژه</td>
                                <td>مشیر صرافی</td>
                                <td class="text-muted">۱۴/۰۲/۲۹</td>
                                <td class="text-center">
                                    <button class="btn-action"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                    <button class="btn-action"><i class="fa-regular fa-pen-to-square"></i></button>
                                    <button class="btn-action"><i class="fa-regular fa-trash-can"></i></button>
                                </td>
                            </tr>

                            <tr>
                                <td class="text-center"><input class="form-check-input" type="checkbox"></td>
                                <td class="text-center">3</td>
                                <td class="text-center envelope-dropdown">
                                    <div class="dropdown">
                                        <i class="fa-regular fa-envelope-open envelope-icon read dropdown-toggle" data-bs-toggle="dropdown"></i>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, true)"><i class="fa-regular fa-envelope-open me-2"></i>خوانده شده</a></li>
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, false)"><i class="fa-solid fa-envelope me-2"></i>خوانده نشده</a></li>
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center"><i class="fa-solid fa-bell prio-very-immediate" title="خیلی فوری"></i></td>
                                <td class="text-center"><i class="fa-solid fa-lock conf-secret" title="سری"></i></td>
                                <td><span class="fw-bold text-dark">۴۸۷۶</span></td>
                                <td>مجوزهای دسترسی سطح بالا</td>
                                <td>نیما خمسه</td>
                                <td class="text-muted">۱۴/۰۲/۲۹</td>
                                <td class="text-center">
                                    <button class="btn-action"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                </td>
                            </tr>

                            <tr>
                                <td class="text-center"><input class="form-check-input" type="checkbox"></td>
                                <td class="text-center">
                                    <div class="attachment-pin-wrapper">
                                        4 <i class="fa-solid fa-paperclip attachment-pin"></i>
                                    </div>
                                </td>
                                <td class="text-center envelope-dropdown">
                                    <div class="dropdown">
                                        <i class="fa-solid fa-envelope envelope-icon unread dropdown-toggle" data-bs-toggle="dropdown"></i>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, true)"><i class="fa-regular fa-envelope-open me-2"></i>خوانده شده</a></li>
                                            <li><a class="dropdown-item small cursor-pointer" onclick="setReadStatus(this, false)"><i class="fa-solid fa-envelope me-2"></i>خوانده نشده</a></li>
                                        </ul>
                                    </div>
                                </td>
                                <td class="text-center"><i class="fa-solid fa-bell text-muted opacity-50" title="عادی"></i></td>
                                <td class="text-center"><i class="fa-solid fa-lock conf-top-secret" title="به کلی سری"></i></td>
                                <td><span class="fw-bold text-dark">۱۲۷۷۴۷</span></td>
                                <td>اطلاعات طبقه‌بندی شده</td>
                                <td>امیرسامان صمدی</td>
                                <td class="text-muted">۱۴/۰۲/۲۹</td>
                                <td class="text-center">
                                    <button class="btn-action"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top d-flex justify-content-between align-items-center bg-white rounded-bottom-4">
                    <small class="text-muted">نمایش ۱ تا ۴ از ۴۷ ورودی</small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#"><i class="fa-solid fa-chevron-right"></i></a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">...</a></li>
                            <li class="page-item"><a class="page-link" href="#">8</a></li>
                            <li class="page-item"><a class="page-link" href="#"><i class="fa-solid fa-chevron-left"></i></a></li>
                        </ul>
                    </nav>
                </div>

            </div>
        </div>
    </div>

</div>