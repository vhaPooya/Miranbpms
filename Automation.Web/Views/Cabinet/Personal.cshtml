@{
    ViewData["Title"] = "کارتابل شخصی";
    Layout = "_LayoutGlass";
}

<div class="page-title" style="font-size: 1.5rem; font-weight: 700; margin-bottom: 15px; text-align: right; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">کارتابل شخصی</div>

<div class="filter-toolbar" style="background: var(--glass-bg-base); border: 1px solid var(--border-light); backdrop-filter: blur(12px); border-radius: 16px; padding: 10px 15px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 15px; flex-direction: row-reverse;">
    <div class="tools-left" style="display: flex; gap: 10px;">
        <div class="search-box" style="display: flex; align-items: center; background: rgba(0,0,0,0.2); padding: 0 10px; border-radius: 10px; border: 1px solid var(--border-light);">
            <input type="text" id="searchInput" placeholder="جستجو..." style="background: transparent; border: none; padding: 8px; color: white; outline: none; width: 250px; font-family: inherit;">
            <i class="fa-solid fa-magnifying-glass" style="color: var(--text-gray);"></i>
        </div>
    </div>
    <button class="btn-large btn-save-send" onclick="createPersonalDocument()" style="padding: 8px 15px; font-size: 0.85rem;">
        <i class="fa-solid fa-plus" style="margin-left: 5px;"></i>ایجاد مدرک شخصی
    </button>
</div>

<div class="table-scroll-wrapper" style="flex-grow: 1; overflow-y: auto; border-radius: 18px; background: var(--glass-bg-base); border: 1px solid var(--border-light); backdrop-filter: blur(10px); padding: 5px; min-height: 400px;">
    <table class="custom-table">
        <thead>
            <tr>
                <th>شماره مدرک</th>
                <th>موضوع</th>
                <th>نوع مدرک</th>
                <th>تاریخ ایجاد</th>
                <th>وضعیت</th>
                <th style="width: 100px;">عملیات</th>
            </tr>
        </thead>
        <tbody id="personalTableBody">
            <tr><td colspan="6" class="text-center" style="color: var(--text-gray);">در حال بارگذاری...</td></tr>
        </tbody>
    </table>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;

    async function loadPersonal(page = 1) {
        try {
            const search = document.getElementById('searchInput').value;
            const response = await fetch(`/api/cabinet/personal?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search || '')}`);
            const result = await response.json();
            
            if (result.success) {
                renderPersonal(result.data.items || []);
            }
        } catch (error) {
            console.error('Error loading personal:', error);
        }
    }

    function renderPersonal(items) {
        const tbody = document.getElementById('personalTableBody');
        tbody.innerHTML = '';
        
        if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="color: var(--text-gray);">مدرکی یافت نشد</td></tr>';
            return;
        }
        
        items.forEach((item, index) => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${item.documentNumber || '-'}</td>
                <td>${item.subject || '-'}</td>
                <td>${item.documentType || '-'}</td>
                <td>${item.createdDateTime ? new Date(item.createdDateTime).toLocaleDateString('fa-IR') : '-'}</td>
                <td>
                    <span style="padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; background: ${item.status === 'COMPLETED' ? 'rgba(16, 185, 129, 0.2)' : item.status === 'PENDING' ? 'rgba(245, 158, 11, 0.2)' : 'rgba(148, 163, 184, 0.2)'}; color: ${item.status === 'COMPLETED' ? '#10b981' : item.status === 'PENDING' ? '#f59e0b' : '#94a3b8'};">
                        ${item.status || '-'}
                    </span>
                </td>
                <td>
                    <div class="action-btn-small" style="width: 28px; height: 28px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-light); display: inline-flex; align-items: center; justify-content: center; color: var(--text-gray); cursor: pointer; transition: 0.3s; font-size: 0.8rem;" onclick="viewDocument('${item.documentId}')" title="مشاهده">
                        <i class="fa-regular fa-eye"></i>
                    </div>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function viewDocument(documentId) {
        window.location.href = `/cabinet/documents/${documentId}`;
    }

    function createPersonalDocument() {
        // TODO: Implement create personal document functionality
        alert('ایجاد مدرک شخصی در حال توسعه است');
    }

    document.getElementById('searchInput').addEventListener('keyup', (e) => {
        if (e.key === 'Enter') loadPersonal(1);
    });

    document.addEventListener('DOMContentLoaded', () => {
        loadPersonal();
    });
</script>

