@{
    ViewData["Title"] = "کارتابل ارجاعی";
    Layout = "_LayoutGlass";
}

<div class="card border-0 custom-shadow rounded-4 mb-3">
    <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">

        <div class="filter-tabs d-flex gap-2 overflow-auto pb-1 pb-md-0">
            <button class="btn active">همه <span class="badge bg-primary-subtle text-primary ms-1 rounded-pill">12</span></button>
            <button class="btn">برگشت خورده‌ها <span class="badge bg-danger-subtle text-danger ms-1 rounded-pill">2</span></button>
            <button class="btn">انجام شده</button>
            <button class="btn">درحال بررسی</button>
            <button class="btn">ارسال شده</button>
        </div>

        <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0">
            <div class="input-group input-group-sm" style="max-width: 220px;">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" class="form-control bg-light border-start-0" placeholder="جستجو در ارجاعات...">
            </div>
            <button class="btn btn-sm btn-light border text-secondary"><i class="fa-solid fa-sliders"></i></button>
        </div>

    </div>
</div>

<div class="table-container">
    <div class="table-responsive" style="overflow-x: visible;">
        <table class="table table-custom mb-0">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">ردیف</th>
                    <th class="text-center" style="width: 50px;">وضعیت</th>
                    <th class="text-center" style="width: 50px;">اولویت</th>
                    <th class="text-center" style="width: 50px;">محرمانگی</th>
                    <th>گیرنده / طرف مکاتبه</th>
                    <th>شماره نامه</th>
                    <th>موضوع</th>
                    <th>تاریخ ارجاع</th>
                    <th class="text-center" style="width: 80px;">عملیات</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td class="text-center fw-bold text-secondary">۱</td>
                    <td class="text-center envelope-dropdown">
                        <div class="dropdown">
                            <i class="fa-solid fa-envelope icon-view unread dropdown-toggle" data-bs-toggle="dropdown" title="خوانده نشده"></i>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small cursor-pointer" onclick="setStatus(this, 'read')"><i class="fa-regular fa-envelope-open me-2 text-warning"></i>مشاهده شده</a></li>
                                <li><a class="dropdown-item small cursor-pointer" onclick="setStatus(this, 'unread')"><i class="fa-solid fa-envelope me-2 text-success"></i>خوانده نشده</a></li>
                            </ul>
                        </div>
                    </td>
                    <td class="text-center"><i class="fa-solid fa-bell text-secondary opacity-50" title="عادی"></i></td>
                    <td class="text-center"><i class="fa-solid fa-lock-open text-secondary opacity-50" title="عادی"></i></td>
                    <td>
                        <div class="d-flex align-items-center gap-2 user-cell">
                            <img src="https://i.pravatar.cc/150?img=12" alt="User">
                            <div class="user-info">
                                <h6>خاص تانی</h6>
                                <small>مدیر فنی و مهندسی</small>
                            </div>
                        </div>
                    </td>
                    <td><span class="fw-bold text-dark">۴۴-۸۹۲۱</span></td>
                    <td>کارتابل نامه‌های اداری</td>
                    <td class="text-muted">۱۴/۰۲/۲۹</td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn-action" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-print me-2"></i>چاپ</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small text-danger" href="#"><i class="fa-solid fa-ban me-2"></i>انصراف</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td class="text-center fw-bold text-secondary">2</td>
                    <td class="text-center envelope-dropdown">
                        <div class="dropdown">
                            <i class="fa-regular fa-envelope-open icon-view read dropdown-toggle" data-bs-toggle="dropdown" title="مشاهده شده"></i>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small cursor-pointer" onclick="setStatus(this, 'read')"><i class="fa-regular fa-envelope-open me-2 text-warning"></i>مشاهده شده</a></li>
                                <li><a class="dropdown-item small cursor-pointer" onclick="setStatus(this, 'unread')"><i class="fa-solid fa-envelope me-2 text-success"></i>خوانده نشده</a></li>
                            </ul>
                        </div>
                    </td>
                    <td class="text-center"><i class="fa-solid fa-bell priority-urgent" title="فوری"></i></td>
                    <td class="text-center"><i class="fa-solid fa-lock conf-secret" title="محرمانه"></i></td>
                    <td>
                        <div class="d-flex align-items-center gap-2 user-cell">
                            <img src="https://i.pravatar.cc/150?img=59" alt="User">
                            <div class="user-info">
                                <h6>مدریک دیبا</h6>
                                <small>معاونت اجرایی</small>
                            </div>
                        </div>
                    </td>
                    <td><span class="fw-bold text-dark">۱۱-۷۷۶۲</span></td>
                    <td>گزارش هفته اول اسفند</td>
                    <td class="text-muted">۱۴/۰۲/۲۶</td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn-action" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-print me-2"></i>چاپ</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small text-danger" href="#"><i class="fa-solid fa-ban me-2"></i>انصراف</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td class="text-center fw-bold text-secondary">3</td>
                    <td class="text-center envelope-dropdown">
                        <div class="dropdown">
                            <i class="fa-solid fa-envelope icon-view unread dropdown-toggle" data-bs-toggle="dropdown" title="خوانده نشده"></i>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small cursor-pointer" onclick="setStatus(this, 'read')"><i class="fa-regular fa-envelope-open me-2 text-warning"></i>مشاهده شده</a></li>
                                <li><a class="dropdown-item small cursor-pointer" onclick="setStatus(this, 'unread')"><i class="fa-solid fa-envelope me-2 text-success"></i>خوانده نشده</a></li>
                            </ul>
                        </div>
                    </td>
                    <td class="text-center"><i class="fa-solid fa-bell priority-critical" title="خیلی فوری"></i></td>
                    <td class="text-center">
                        <span class="position-relative">
                            <i class="fa-solid fa-lock conf-top-secret" title="بکلی سری"></i>
                            <i class="fa-solid fa-ban conf-ban-icon text-danger"></i>
                        </span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2 user-cell">
                            <img src="https://i.pravatar.cc/150?img=33" alt="User">
                            <div class="user-info">
                                <h6>دامی سیمون</h6>
                                <small>منابع انسانی</small>
                            </div>
                        </div>
                    </td>
                    <td><span class="fw-bold text-dark">۹۰-۲۱۲۱</span></td>
                    <td>درخواست مرخصی استعلاجی</td>
                    <td class="text-muted">۱۴/۰۲/۲۱</td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn-action" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-custom fs-7">
                                <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-print me-2"></i>چاپ</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small text-danger" href="#"><i class="fa-solid fa-ban me-2"></i>انصراف</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    <div class="p-3 d-flex justify-content-between align-items-center rounded-bottom-4 mt-2">
        <small class="text-muted">نمایش ۱ تا ۳ از ۱۲ ارجاع</small>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link" href="#"><i class="fa-solid fa-chevron-right"></i></a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#"><i class="fa-solid fa-chevron-left"></i></a></li>
            </ul>
        </nav>
    </div>

</div>
