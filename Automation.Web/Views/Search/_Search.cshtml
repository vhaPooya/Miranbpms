@{
    ViewData["Title"] = "جستجو پیشرفته";
    Layout = "_LayoutGlass";
}

<div class="card border-0 custom-shadow rounded-4 mb-4 search-card">
    <div class="card-body p-4">
        <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">
            <i class="fa-solid fa-filter me-2 text-primary"></i>پارامترهای جستجو
        </h6>

        <div class="row g-3 justify-content-center mb-3">
            <div class="col-md-4 col-lg-3">
                <label class="form-label-sm">نوع مدرک</label>
                <select class="form-select form-select-sm" id="docType" onchange="showCriteria()">
                    <option value="" selected disabled>انتخاب کنید...</option>
                    <option>سربرگ</option>
                    <option>مرخصی روزانه</option>
                    <option>ماموریت روزانه</option>
                    <option>درخواست کالا</option>
                    <option>صورتجلسه</option>
                </select>
            </div>
        </div>

        <div class="row g-3 justify-content-center align-items-end d-none-custom animate-fade-in" id="row-criteria">

            <div class="col-md-4 col-lg-3">
                <label class="form-label-sm">جستجو براساس</label>
                <select class="form-select form-select-sm" id="searchCriteria" onchange="toggleFields()">
                    <option value="" selected disabled>انتخاب کنید...</option>
                    <option value="subject">موضوع / متن نامه</option>
                    <option value="date">تاریخ مدرک</option>
                    <option value="daterange">بازه ای از تاریخ</option>
                    <option value="user">فرستنده / گیرنده</option>
                    <option value="number">شماره (صادره/وارده/داخلی)</option>
                </select>
            </div>

            <div class="col-md-6 col-lg-4">

                <div id="field-subject" class="d-none-custom animate-fade-in">
                    <label class="form-label-sm">عبارت جستجو</label>
                    <input type="text" class="form-control form-control-sm" placeholder="بخشی از متن...">
                </div>

                <div id="field-date" class="d-none-custom animate-fade-in">
                    <label class="form-label-sm">تاریخ مدرک</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" placeholder="۱۴۰۴/۰۱/۰۱">
                        <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                    </div>
                </div>

                <div id="field-daterange" class="d-none-custom animate-fade-in">
                    <div class="d-flex gap-2">
                        <div class="flex-grow-1">
                            <label class="form-label-sm">از تاریخ</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control">
                                <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <label class="form-label-sm">تا تاریخ</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control">
                                <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="field-user" class="d-none-custom animate-fade-in">
                    <label class="form-label-sm">طرف مکاتبه</label>
                    <div class="input-group input-group-sm cursor-pointer" onclick="openModal()">
                        <input type="text" id="userInput" class="form-control bg-white" placeholder="انتخاب کنید..." readonly>
                        <span class="input-group-text"><i class="fa-solid fa-user-tag"></i></span>
                    </div>
                </div>

                <div id="field-number" class="d-none-custom animate-fade-in">
                    <label class="form-label-sm">شماره مدرک</label>
                    <input type="text" class="form-control form-control-sm" placeholder="شماره...">
                </div>
            </div>

            <div class="col-md-2 d-none-custom animate-fade-in" id="row-search-btn">
                <button class="btn btn-primary btn-sm w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> جستجو
                </button>
            </div>

        </div>
    </div>
</div>

<div class="card border-0 custom-shadow rounded-4">
    <div class="card-body p-0">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white rounded-top-4">
            <h6 class="m-0 fw-bold text-dark">نتیجه جستجو</h6>
            <span class="badge bg-light text-secondary border rounded-pill">۵ مورد یافت شد</span>
        </div>

        <div class="table-responsive">
            <table class="table table-custom table-hover mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width:50px">ردیف</th>
                        <th>تاریخ مدرک</th>
                        <th>فرستنده / گیرنده</th>
                        <th>موضوع</th>
                        <th>شماره</th>
                        <th class="text-center" style="width:100px">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">۱</td>
                        <td>۱۴۰۴/۰۲/۱۵</td>
                        <td>شرکت ملی گاز</td>
                        <td class="fw-bold text-dark">درخواست انشعاب جدید فاز ۲</td>
                        <td>۹۹/۵۱۱۲</td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn-action" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                    <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                    <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-pen me-2"></i>ویرایش</a></li>
                                    <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-print me-2"></i>چاپ</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">2</td>
                        <td>۱۴۰۴/۰۲/۱8</td>
                        <td>واحد منابع انسانی</td>
                        <td class="fw-bold text-dark">احکام سال جدید</td>
                        <td>1404/HR/20</td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn-action" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                    <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
