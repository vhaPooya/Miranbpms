@model List<Automation.Core.Entities.Form>
@{
    ViewData["Title"] = "لیست فرم‌ها";
    Layout = "_LayoutGlass";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex align-items-center justify-content-between">
            <h4 class="mb-0">
                <i class="bi bi-collection me-2"></i>
                لیست فرم‌ها
            </h4>
            <a asp-action="Index" class="btn btn-primary" target="_blank">
                <i class="bi bi-plus-lg me-1"></i>
                فرم جدید
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                        <h5 class="text-muted">هنوز فرمی ایجاد نشده است</h5>
                        <p class="text-muted">برای شروع، یک فرم جدید ایجاد کنید</p>
                        <a asp-action="Index" class="btn btn-primary" target="_blank">
                            <i class="bi bi-plus-lg me-1"></i>
                            ایجاد فرم جدید
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" class="form-control border-start-0" id="search-input" placeholder="جستجوی فرم...">
                                </div>
                            </div>
                            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                <span class="text-muted">@Model.Count فرم</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0" id="forms-table">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 100px;">کد</th>
                                    <th>نام فرم</th>
                                    <th style="width: 150px;">دسته‌بندی</th>
                                    <th style="width: 80px;">نسخه</th>
                                    <th style="width: 100px;">وضعیت</th>
                                    <th style="width: 150px;">تاریخ ایجاد</th>
                                    <th style="width: 120px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var form in Model)
                                {
                                    <tr>
                                        <td><code>@form.FormCode</code></td>
                                        <td>
                                            <strong>@form.NameFa</strong>
                                            @if (!string.IsNullOrEmpty(form.NameEn))
                                            {
                                                <br><small class="text-muted">@form.NameEn</small>
                                            }
                                        </td>
                                        <td>
                                            @if (form.Category != null)
                                            {
                                                <span class="badge bg-secondary">@form.Category.NameFa</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">v@form.Version</span>
                                        </td>
                                        <td>
                                            @if (form.IsPublished)
                                            {
                                                <span class="badge bg-success">منتشر شده</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">پیش‌نویس</span>
                                            }
                                        </td>
                                        <td>
                                            <small>@form.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Index" asp-route-id="@form.Id" class="btn btn-outline-primary" title="ویرایش" target="_blank">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="/api/formbuilder/forms/@form.Id/preview" target="_blank" class="btn btn-outline-secondary" title="پیش‌نمایش">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-danger btn-delete" data-id="@form.Id" title="حذف">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Search functionality
        document.getElementById('search-input')?.addEventListener('input', function(e) {
            const search = e.target.value.toLowerCase();
            document.querySelectorAll('#forms-table tbody tr').forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(search) ? '' : 'none';
            });
        });

        // Delete functionality
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.dataset.id;
                if (!confirm('آیا از حذف این فرم اطمینان دارید؟')) return;

                try {
                    const response = await fetch(`/api/formbuilder/forms/${id}`, { method: 'DELETE' });
                    const result = await response.json();
                    if (result.success) {
                        this.closest('tr').remove();
                    } else {
                        alert('خطا در حذف فرم');
                    }
                } catch (error) {
                    console.error('Delete error:', error);
                    alert('خطا در ارتباط با سرور');
                }
            });
        });
    </script>
}
