{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=BPMSMasterDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExternalServices": {
    "ERP": {
      "BaseUrl": "https://erp.company.com",
      "ApiKey": "your-erp-api-key-here",
      "Enabled": true
    },
    "CRM": {
      "BaseUrl": "https://crm.company.com",
      "ApiKey": "your-crm-api-key-here",
      "Enabled": true
    },
    "Payment": {
      "BaseUrl": "https://payment.gateway.com",
      "ApiKey": "your-payment-api-key-here",
      "Enabled": true
    },
    "SMS": {
      "BaseUrl": "https://sms.service.com",
      "ApiKey": "your-sms-api-key-here",
      "Enabled": true
    }
  },
  "ApiGateway": {
    "DefaultTimeoutSeconds": 30,
    "EnableCaching": true,
    "DefaultCacheMinutes": 5,
    "MaxRetryAttempts": 3
  },
  "DatabaseConnections": {
    "LegacySystem": {
      "ConnectionString": "Server=legacy-server;Database=LegacyDB;User Id=sa;Password=password;",
      "Provider": "SQLServer"
    },
    "ReportingDb": {
      "ConnectionString": "Server=reporting-server;Database=Reports;User Id=reportuser;Password=reportpass;",
      "Provider": "SQLServer"
    }
  }
}
