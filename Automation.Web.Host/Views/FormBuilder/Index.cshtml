<!-- 4. Print Template Modal -->
<div class="modal fade" id="modal-print-template" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-printer me-2"></i>مدیریت قالب‌های چاپ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    برای ایجاد قالب چاپ، یک فایل Word (.docx) طراحی کنید و نام هر فیلد فرم را به عنوان بوکمارک در آن قرار دهید.
                    سپس فایل را در اینجا آپلود کنید.
                </div>

                <!-- Templates List -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6>قالب‌های موجود</h6>
                        <button type="button" class="btn btn-sm btn-primary" id="btn-add-new-template">
                            <i class="bi bi-plus-lg me-1"></i>افزودن قالب جدید
                        </button>
                    </div>
                    <div id="print-templates-list-manager" class="list-group">
                        <!-- Templates will be loaded here -->
                    </div>
                </div>

                <!-- Add/Edit Template Form -->
                <div id="print-template-form" class="card border-primary d-none">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0" id="template-form-title">افزودن قالب جدید</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">نام قالب <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="template-name" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ترتیب نمایش</label>
                                <input type="number" class="form-control" id="template-display-order" value="0">
                            </div>
                            <div class="col-12">
                                <label class="form-label">توضیحات</label>
                                <textarea class="form-control" id="template-description" rows="2"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">فایل Word (.docx) <span class="text-danger">*</span></label>
                                <input type="file" class="form-control" id="template-file" accept=".docx">
                                <small class="text-muted">فقط فایل‌های Word با فرمت .docx مجاز هستند</small>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="template-is-default">
                                    <label class="form-check-label" for="template-is-default">
                                        قالب پیش‌فرض
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="button" class="btn btn-primary" id="btn-save-template">
                            <i class="bi bi-save me-1"></i>ذخیره
                        </button>
                        <button type="button" class="btn btn-secondary" id="btn-cancel-template">انصراف</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- 5. Database Connection Modal -->
<div class="modal fade" id="modal-database-connection" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-database me-2"></i>اتصال به دیتابیس</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="height: calc(100vh - 120px);">
                <div class="row g-0 h-100">
                    <!-- Left Side: Tables/Views and Functions/Procedures List -->
                    <div class="col-md-4 border-end bg-light" style="overflow-y: auto;">
                        <div class="p-3">
                            <ul class="nav nav-tabs nav-fill mb-3" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#db-tab-tables">
                                        <i class="bi bi-table me-1"></i>جداول و ویوها
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#db-tab-functions">
                                        <i class="bi bi-function me-1"></i>توابع و پروسیجرها
                                    </button>
                                </li>
                            </ul>
                            
                            <div class="tab-content">
                                <!-- Tables/Views Tab -->
                                <div class="tab-pane fade show active" id="db-tab-tables">
                                    <div class="input-group mb-3">
                                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control form-control-sm" id="db-search-tables" placeholder="جستجوی جدول...">
                                    </div>
                                    <div id="db-tables-list" class="list-group" style="max-height: calc(100vh - 300px); overflow-y: auto;">
                                        <div class="text-center text-muted py-4">
                                            <i class="bi bi-hourglass-split"></i> در حال بارگذاری...
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Functions/Procedures Tab -->
                                <div class="tab-pane fade" id="db-tab-functions">
                                    <div class="input-group mb-3">
                                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control form-control-sm" id="db-search-functions" placeholder="جستجوی تابع...">
                                    </div>
                                    <div id="db-functions-list" class="list-group" style="max-height: calc(100vh - 300px); overflow-y: auto;">
                                        <div class="text-center text-muted py-4">
                                            <i class="bi bi-hourglass-split"></i> در حال بارگذاری...
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Right Side: Table Diagram -->
                    <div class="col-md-8" style="overflow-y: auto;">
                        <div class="p-3">
                            <div id="db-diagram-container">
                                <div class="text-center text-muted py-5">
                                    <i class="bi bi-diagram-3 display-4 d-block mb-3"></i>
                                    <p>یک جدول، ویو یا تابع را از سمت چپ انتخاب کنید</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btn-confirm-db-selection" disabled>
                    <i class="bi bi-check-lg me-1"></i>تأیید و انتقال به تب اختصاصی
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 6. Action Buttons Config Modal -->
<div class="modal fade" id="modal-action-buttons" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-lightning-charge me-2"></i>مدیریت دکمه‌های عملیاتی</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="min-height: 500px;">
                <div class="row g-0 h-100">
                    <!-- Left Panel: Available Button Types -->
                    <div class="col-md-3 border-end bg-light" style="max-height: 500px; overflow-y: auto;">
                        <div class="p-3">
                            <h6 class="mb-3"><i class="bi bi-list-check me-1"></i>دکمه‌های آماده</h6>
                            <!-- Category Tabs -->
                            <ul class="nav nav-pills nav-fill mb-3" id="btntype-category-tabs">
                                <li class="nav-item">
                                    <button class="nav-link active btn-sm px-2" data-category="all">همه</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link btn-sm px-2" data-category="document">سندی</button>
                                </li>
                                <li class="nav-item">
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link btn-sm px-2" data-category="utility">ابزاری</button>
                                </li>
                            </ul>
                            <div id="available-buttons-list">
                                <!-- Loaded dynamically -->
                            </div>
                            <hr>
                            <button type="button" class="btn btn-outline-success btn-sm w-100" id="btn-add-process-service">
                                <i class="bi bi-gear me-1"></i>افزودن سرویس
                            </button>
                        </div>
                    </div>

                    <!-- Middle Panel: Active Buttons for this Form -->
                    <div class="col-md-4 border-end" style="max-height: 500px; overflow-y: auto;">
                        <div class="p-3">
                            <h6 class="mb-3"><i class="bi bi-check2-square me-1"></i>دکمه‌های فعال فرم</h6>
                            <div id="active-buttons-list" class="list-group">
                                <div class="text-center text-muted py-4" id="no-active-buttons">
                                    <i class="bi bi-arrow-right-circle d-block mb-2" style="font-size: 2rem;"></i>
                                    از پنل سمت راست دکمه اضافه کنید
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Panel: Selected Button Settings -->
                    <div class="col-md-5" style="max-height: 500px; overflow-y: auto;">
                        <div class="p-3">
                            <h6 class="mb-3"><i class="bi bi-gear me-1"></i>تنظیمات دکمه</h6>
                            <div id="button-settings-panel">
                                <div class="text-center text-muted py-4" id="no-button-selected">
                                    <i class="bi bi-hand-index d-block mb-2" style="font-size: 2rem;"></i>
                                    یک دکمه را از لیست فعال انتخاب کنید
                                </div>
                                <div id="button-settings-form" class="d-none">
                                    <!-- Custom Title -->
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label small">عنوان سفارشی (فارسی)</label>
                                            <input type="text" class="form-control form-control-sm" id="btn-custom-title-fa" dir="rtl">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">عنوان سفارشی (انگلیسی)</label>
                                            <input type="text" class="form-control form-control-sm" id="btn-custom-title-en" dir="ltr">
                                        </div>
                                    </div>
                                    <!-- Display Mode -->
                                    <div class="mb-3">
                                        <label class="form-label small">حالت نمایش</label>
                                        <select class="form-select form-select-sm" id="btn-display-mode">
                                            <option value="icon_and_title">آیکون + عنوان</option>
                                            <option value="icon_only">فقط آیکون</option>
                                            <option value="title_only">فقط عنوان</option>
                                        </select>
                                    </div>
                                    <!-- Icon -->
                                    <div class="mb-3">
                                        <label class="form-label small">آیکون سفارشی (کلاس CSS)</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text" id="btn-icon-preview"><i class="bi bi-circle"></i></span>
                                            <input type="text" class="form-control" id="btn-custom-icon" placeholder="مثال: fas fa-paper-plane" dir="ltr">
                                        </div>
                                    </div>
                                    <!-- Style Preset -->
                                    <div class="mb-3">
                                        <label class="form-label small">قالب استایل</label>
                                        <select class="form-select form-select-sm" id="btn-style-preset">
                                            <option value="">سفارشی</option>
                                        </select>
                                    </div>
                                    <!-- Custom Styles -->
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label small">رنگ متن</label>
                                            <input type="color" class="form-control form-control-sm form-control-color" id="btn-color" value="#ffffff">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">رنگ پس‌زمینه</label>
                                            <input type="color" class="form-control form-control-sm form-control-color" id="btn-bg-color" value="#0d6efd">
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label small">اندازه فونت (px)</label>
                                            <input type="number" class="form-control form-control-sm" id="btn-font-size" value="14" min="10" max="24">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">گردی حاشیه (px)</label>
                                            <input type="number" class="form-control form-control-sm" id="btn-border-radius" value="6" min="0" max="50">
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label small">پدینگ</label>
                                            <input type="text" class="form-control form-control-sm" id="btn-padding" placeholder="6px 12px" dir="ltr">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">مارجین</label>
                                            <input type="text" class="form-control form-control-sm" id="btn-margin" placeholder="0 4px" dir="ltr">
                                        </div>
                                    </div>
                                    <!-- Process Service Section (hidden for predefined buttons) -->
                                    <div id="process-service-section" class="d-none">
                                        <hr>
                                        <h6 class="text-success"><i class="bi bi-gear me-1"></i>تنظیمات فرآیندی</h6>
                                        <div class="alert alert-light border small py-2">
                                            فرآیندساز فعلا حذف شده و بعدا دوباره طراحی می‌شود.
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small">وارث خاصیت دکمه</label>
                                            <select class="form-select form-select-sm" id="btn-inherit-from">
                                                <option value="">بدون وراثت</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small">زمان اجرا</label>
                                            <select class="form-select form-select-sm" id="btn-execution-timing">
                                                <option value="after">بعد از دکمه وارث</option>
                                                <option value="before">قبل از دکمه وارث</option>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- Other -->
                                    <hr>
                                    <div class="mb-3">
                                        <label class="form-label small">پیام تایید (قبل از اجرا)</label>
                                        <input type="text" class="form-control form-control-sm" id="btn-confirmation-msg" dir="rtl" placeholder="آیا مطمئن هستید؟">
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="btn-is-enabled" checked>
                                        <label class="form-check-label small" for="btn-is-enabled">فعال</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="me-auto">
                    <label class="form-label small mb-0 me-2">قالب استایل کلی:</label>
                    <select class="form-select form-select-sm d-inline-block" id="global-button-style-preset" style="width: auto;">
                        <option value="">پیشفرض</option>
                    </select>
                </div>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btn-save-action-buttons">
                    <i class="bi bi-save me-1"></i>ذخیره دکمه‌ها
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/javascript/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/htmlmixed/htmlmixed.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="https://unpkg.com/@@minasmart/jalali-date-picker@1.2.0/dist/jalali-date-picker.js"></script>
    <!-- Quill Rich Text Editor -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <!-- Signature Pad -->
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.umd.min.js"></script>
    <script src="~/js/formbuilder/formbuilder.js" asp-append-version="true"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Pass server-side data to JS
            const config = {
                formId: '@(form?.Id)',
                isNew: @(isNew.ToString().ToLower()),
                formType: '@(form?.FormType)',
                initialData: @Html.Raw(form?.DesignData ?? "null"),
                customScripts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(form?.CustomScripts ?? "")),
                customStyles: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(form?.CustomStyles ?? "")),
                fieldTypes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.FieldTypes))
            };
            
            window.fbEngine = new FormBuilderEngine(config);
        });
    </script>
}
