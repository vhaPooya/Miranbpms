@using Automation.Core.Entities
@using Automation.Web.Controllers
@{
    ViewData["Title"] = "طراحی فرم";
    Layout = "_FormsazLayout";
    
    var fieldTypes = ViewBag.FieldTypes as List<FieldType> ?? new List<FieldType>();
    var categories = ViewBag.Categories as List<FormCategory> ?? new List<FormCategory>();
    var form = ViewBag.Form as dynamic;
    var isNew = ViewBag.IsNew as bool? ?? true;
    
    var inputTypes = fieldTypes.Where(ft => ft.Category == FieldTypeCategory.Input).ToList();
    var layoutTypes = fieldTypes.Where(ft => ft.Category == FieldTypeCategory.Layout).ToList();
    var staticTypes = fieldTypes.Where(ft => ft.Category == FieldTypeCategory.Static).ToList();
    var actionTypes = fieldTypes.Where(ft => ft.Category == FieldTypeCategory.Action).ToList();
}

@section Styles {
    <link href="~/css/site-compact.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/formbuilder.css" asp-append-version="true" rel="stylesheet" />
    <!-- Persian Date Picker -->
    <link href="https://unpkg.com/@@minasmart/jalali-date-picker@1.2.0/dist/jalali-date-picker.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/monokai.min.css">
    <!-- Quill Rich Text Editor -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <!-- Signature Pad -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.css">

    <style>
        /* FormBuilder Overrides for Light Theme */
        body {
            background-image: none !important;
            background-color: var(--bg-body) !important;
        }
        .fb-navbar {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%) !important;
            box-shadow: var(--shadow-md) !important;
            border-bottom: none !important;
        }
        .fb-brand {
            color: white !important;
            text-shadow: none !important;
        }
        .fb-brand i {
            color: rgba(255,255,255,0.8) !important;
        }
        .btn-glass {
            background: rgba(255,255,255,0.1) !important;
            border: 1px solid rgba(255,255,255,0.2) !important;
            color: white !important;
        }
        .btn-glass:hover {
            background: rgba(255,255,255,0.2) !important;
        }
        .fb-sidebar {
            background: #fff !important;
            border-left: 1px solid var(--border-color) !important;
            box-shadow: none !important;
        }
        .fb-sidebar-header {
            background: #f8fafc !important;
            border-bottom: 1px solid var(--border-color) !important;
        }
        .nav-pills .nav-link {
            color: var(--text-secondary) !important;
        }
        .nav-pills .nav-link:hover {
            background: var(--bg-hover) !important;
            color: var(--primary) !important;
        }
        .nav-pills .nav-link.active {
            background: var(--primary) !important;
            color: white !important;
        }
        .fb-component-item {
            background: #fff !important;
            border: 1px solid var(--border-color) !important;
            box-shadow: var(--shadow-sm) !important;
        }
        .fb-component-item:hover {
            border-color: var(--primary) !important;
            transform: translateY(-2px);
            box-shadow: var(--shadow-md) !important;
        }
        .fb-component-item span {
            color: var(--text-primary) !important;
        }
        .fb-component-item i {
            color: var(--primary) !important;
            filter: none !important;
        }
        .accordion-button {
            color: var(--text-primary) !important;
        }
        .accordion-button:not(.collapsed) {
            background: rgba(30, 58, 95, 0.05) !important;
            color: var(--primary) !important;
        }
        .accordion-button::after {
            filter: none !important;
        }
        .fb-canvas-wrapper {
            background: #fff !important;
            border: 1px solid var(--border-color) !important;
            box-shadow: var(--shadow-lg) !important;
        }
        .fb-canvas-content {
            background-image: radial-gradient(rgba(0,0,0,0.1) 1px, transparent 1px) !important;
        }
        .glass-modal {
            background: #fff !important;
            border: 1px solid var(--border-color) !important;
            color: var(--text-primary) !important;
            box-shadow: var(--shadow-lg) !important;
        }
        .glass-modal .modal-header {
            background: #f8fafc !important;
            border-bottom: 1px solid var(--border-color) !important;
            color: var(--primary) !important;
        }
        .glass-modal .modal-body {
            color: var(--text-primary) !important;
        }
        .glass-modal .form-control, 
        .glass-modal .form-select {
            background: #fff !important;
            border: 1px solid var(--border-color) !important;
            color: var(--text-primary) !important;
        }
        .glass-modal .form-control:focus, 
        .glass-modal .form-select:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.1) !important;
        }
    </style>
}

<div class="form-builder-wrapper">
    <!-- Navbar / Toolbar -->
    <nav class="fb-navbar">
        <div class="fb-navbar-left">
            <span class="fb-brand"><i class="bi bi-ui-checks-grid me-2"></i>فرمساز پیشرفته</span>
        </div>
        <div class="fb-navbar-center">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-glass" id="btn-undo" title="Undo (Ctrl+Z)">
                    <i class="bi bi-arrow-return-right flip-icon"></i>
                </button>
                <button type="button" class="btn btn-glass" id="btn-redo" title="Redo (Ctrl+Y)">
                    <i class="bi bi-arrow-return-left flip-icon"></i>
                </button>
            </div>
            <div class="vr mx-2 text-white-50"></div>
            <button type="button" class="btn btn-glass" id="btn-desktop-view" title="Desktop View"><i class="bi bi-display"></i></button>
            <button type="button" class="btn btn-glass" id="btn-tablet-view" title="Tablet View"><i class="bi bi-tablet"></i></button>
            <button type="button" class="btn btn-glass" id="btn-mobile-view" title="Mobile View"><i class="bi bi-phone"></i></button>
        </div>
        <div class="fb-navbar-right">
            <button type="button" class="btn btn-glass" id="btn-global-script">
                <i class="bi bi-code-slash me-1"></i>اسکریپت فرم
            </button>
            <button type="button" class="btn btn-glass" id="btn-print-template">
                <i class="bi bi-printer me-1"></i>قالب چاپ
            </button>
            <button type="button" class="btn btn-glass" id="btn-form-settings">
                <i class="bi bi-sliders me-1"></i>تنظیمات فرم
            </button>
            <button type="button" class="btn btn-glass" id="btn-action-buttons">
                <i class="bi bi-lightning-charge me-1"></i>دکمه‌های عملیاتی
            </button>
            <div class="vr mx-2 text-white-50"></div>
            <button type="button" class="btn btn-danger" id="btn-clear">
                <i class="bi bi-trash"></i>
            </button>
            <button type="button" class="btn btn-success" id="btn-save">
                <i class="bi bi-save me-1"></i>ذخیره
            </button>
            <button type="button" class="btn btn-warning" id="btn-publish">
                <i class="bi bi-send-check me-1"></i>انتشار فرم
            </button>
            <button type="button" class="btn btn-primary" id="btn-preview">
                <i class="bi bi-eye me-1"></i>پیش‌نمایش
            </button>
        </div>
    </nav>

    <div class="fb-main-content">
        <!-- Sidebar (Components) -->
        <aside class="fb-sidebar">
            <div class="fb-sidebar-header">
                <ul class="nav nav-tabs nav-fill" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-components">
                            <i class="bi bi-box-seam"></i> ابزارها
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-structure">
                            <i class="bi bi-diagram-3"></i> ساختار
                        </button>
                    </li>
                </ul>
            </div>
            
            <div class="tab-content fb-sidebar-body">
                <!-- Components Tab -->
                <div class="tab-pane fade show active" id="tab-components">
                    <div class="p-3">
                        <input type="text" class="form-control form-control-sm fb-search" placeholder="جستجوی ابزار...">
                    </div>
                    
                    <div class="accordion accordion-flush" id="accordionComponents">
                        <!-- Input Controls -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInputs">
                                    <i class="bi bi-input-cursor-text me-2"></i>کنترل‌های ورودی
                                </button>
                            </h2>
                            <div id="collapseInputs" class="accordion-collapse collapse show" data-bs-parent="#accordionComponents">
                                <div class="accordion-body fb-component-grid">
                                    @foreach (var ft in inputTypes)
                                    {
                                        <div class="fb-component-item" draggable="true" data-type="@ft.Name" data-id="@ft.Id">
                                            <i class="@ft.Icon"></i>
                                            <span>@ft.DisplayNameFa</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Layout Controls -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLayout">
                                    <i class="bi bi-layout-split me-2"></i>چیدمان
                                </button>
                            </h2>
                            <div id="collapseLayout" class="accordion-collapse collapse" data-bs-parent="#accordionComponents">
                                <div class="accordion-body fb-component-grid">
                                    @foreach (var ft in layoutTypes)
                                    {
                                        <div class="fb-component-item" draggable="true" data-type="@ft.Name" data-id="@ft.Id" data-container="@ft.IsContainer.ToString().ToLower()">
                                            <i class="@ft.Icon"></i>
                                            <span>@ft.DisplayNameFa</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Static -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStatic">
                                    <i class="bi bi-type me-2"></i>نمایشی
                                </button>
                            </h2>
                            <div id="collapseStatic" class="accordion-collapse collapse" data-bs-parent="#accordionComponents">
                                <div class="accordion-body fb-component-grid">
                                    @foreach (var ft in staticTypes)
                                    {
                                        <div class="fb-component-item" draggable="true" data-type="@ft.Name" data-id="@ft.Id">
                                            <i class="@ft.Icon"></i>
                                            <span>@ft.DisplayNameFa</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Action -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAction">
                                    <i class="bi bi-lightning-charge me-2"></i>دکمه‌ها
                                </button>
                            </h2>
                            <div id="collapseAction" class="accordion-collapse collapse" data-bs-parent="#accordionComponents">
                                <div class="accordion-body fb-component-grid">
                                    @foreach (var ft in actionTypes)
                                    {
                                        <div class="fb-component-item" draggable="true" data-type="@ft.Name" data-id="@ft.Id">
                                            <i class="@ft.Icon"></i>
                                            <span>@ft.DisplayNameFa</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tree Structure Tab -->
                <div class="tab-pane fade" id="tab-structure">
                    <div class="fb-tree-wrapper" id="element-tree">
                        <!-- Tree generated by JS -->
                    </div>
                </div>
            </div>
        </aside>

        <!-- Canvas Area -->
        <main class="fb-canvas-area p-4">
            <div class="fb-canvas-wrapper shadow-lg">
                <!-- Toolbar for Sub-View (Hidden by default) -->
                <div id="canvas-sub-header" class="d-none bg-warning p-2 text-dark d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-window me-1"></i> در حال ویرایش: <b id="current-view-name">Modal 1</b></span>
                    <button class="btn btn-sm btn-outline-dark" id="btn-return-main">بازگشت به فرم اصلی</button>
                </div>

                <div id="form-canvas" class="fb-canvas-content">
                    <div class="fb-drop-zone-empty" id="start-drop-zone">
                        <div class="text-center p-5 text-muted">
                            <i class="bi bi-plus-square-dotted display-4 mb-3"></i>
                            <h5>برای شروع کنترل‌ها را به اینجا بکشید</h5>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Component Tray (For Modals, etc.) -->
            <div id="component-tray-wrapper" class="mt-4">
                <h6 class="text-muted mb-2"><i class="bi bi-collection me-1"></i>کامپوننت‌ها و مدال‌ها</h6>
                <div id="component-tray" class="d-flex flex-wrap gap-3 p-3 bg-white border rounded shadow-sm" style="min-height: 80px;">
                    <!-- Items will be injected here -->
                    <div class="text-muted small w-100 text-center align-self-center">هنوز کامپوننتی اضافه نشده است</div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- 1. Initial/Settings Form Modal -->
<div class="modal fade" id="modal-form-settings" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-gear-fill me-2"></i>تنظیمات فرم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">نام فارسی فرم <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="setting-name-fa" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">نام انگلیسی فرم (نام سیستمی)</label>
                        <input type="text" class="form-control" id="setting-name-en" dir="ltr">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">کد فرم (3 رقمی) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="setting-code" min="100" max="999" placeholder="100">
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label">نوع فرم</label>
                        <select class="form-select" id="setting-form-type">
                            @foreach (var item in Html.GetEnumSelectList<FormCategoryType>())
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">دسته‌بندی</label>
                        <select class="form-select" id="setting-category">
                            <option value="">انتخاب کنید...</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.NameFa</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">
                            قانون شماره‌گذاری
                            <i class="bi bi-question-circle text-muted ms-1" data-bs-toggle="tooltip" title="مثال: yyyy/MM/dd-#### که #### شمارنده خودکار است"></i>
                        </label>
                        <div class="input-group" dir="ltr">
                            <input type="text" class="form-control" id="setting-numbering-prefix" placeholder="Prefix (e.g. LET)">
                            <span class="input-group-text">-</span>
                            <input type="text" class="form-control" id="setting-numbering-rule" placeholder="yyyyMMdd-####">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">اندازه صحنه</label>
                        <select class="form-select" id="setting-canvas-size">
                            <option value="auto">خودکار (Auto)</option>
                            <option value="A4">A4 (210mm x 297mm)</option>
                            <option value="A5">A5 (148mm x 210mm)</option>
                            <option value="Letter">Letter</option>
                            <option value="Custom">سفارشی...</option>
                        </select>
                    </div>
                    
                    <!-- Custom Size Inputs (shown when Custom is selected) -->
                    <div class="col-md-6" id="custom-size-inputs" style="display: none;">
                        <label class="form-label">عرض (Width)</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="setting-custom-width" placeholder="مثال: 800" min="100" step="1">
                            <select class="form-select" id="setting-custom-width-unit" style="max-width: 80px;">
                                <option value="px">px</option>
                                <option value="mm">mm</option>
                                <option value="cm">cm</option>
                                <option value="in">in</option>
                                <option value="%">%</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-md-6" id="custom-size-inputs-height" style="display: none;">
                        <label class="form-label">ارتفاع (Height)</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="setting-custom-height" placeholder="مثال: 600" min="100" step="1">
                            <select class="form-select" id="setting-custom-height-unit" style="max-width: 80px;">
                                <option value="px">px</option>
                                <option value="mm">mm</option>
                                <option value="cm">cm</option>
                                <option value="in">in</option>
                                <option value="%">%</option>
                                <option value="auto">auto</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label">رنگ پس‌زمینه</label>
                        <div class="input-group">
                            <input type="color" class="form-control form-control-color" id="setting-bg-color" value="#ffffff" title="Choose your color">
                            <input type="text" class="form-control" id="setting-bg-image" placeholder="آدرس تصویر (URL)" dir="ltr">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                <button type="button" class="btn btn-primary" id="btn-save-settings">تایید و ادامه</button>
            </div>
        </div>
    </div>
</div>

<!-- 2. Property Modal - Large Centered Modal with 5 Tabs -->
<div class="modal fade" id="modal-properties" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content glass-modal">
            <div class="modal-header bg-gradient-primary text-white py-2">
                <h5 class="modal-title"><i class="bi bi-gear-fill me-2"></i>تنظیمات کنترل: <span id="prop-control-name">-</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            
            <!-- Tabs Navigation -->
            <div class="modal-header bg-light py-1 border-top-0">
                <ul class="nav nav-tabs nav-fill w-100" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active py-2" data-bs-toggle="tab" data-bs-target="#prop-tab-general">
                            <i class="bi bi-sliders2 me-1"></i>عمومی
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2" data-bs-toggle="tab" data-bs-target="#prop-tab-specific">
                            <i class="bi bi-puzzle me-1"></i>اختصاصی
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2" data-bs-toggle="tab" data-bs-target="#prop-tab-validation">
                            <i class="bi bi-shield-check me-1"></i>اعتبارسنجی
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2" data-bs-toggle="tab" data-bs-target="#prop-tab-database">
                            <i class="bi bi-database me-1"></i>دیتابیس
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-2" data-bs-toggle="tab" data-bs-target="#prop-tab-code">
                            <i class="bi bi-code-slash me-1"></i>کد سفارشی
                        </button>
                    </li>
                </ul>
            </div>
            
            <div class="modal-body p-3" style="max-height: 65vh; overflow-y: auto;">
                <div class="tab-content">
                    
                    <!-- ==================== TAB 1: GENERAL ==================== -->
                    <div class="tab-pane fade show active" id="prop-tab-general">
                        
                        <!-- Section 1: Basic Info (Bordered) -->
                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 fw-bold text-primary">مشخصات اصلی</legend>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small">نام فارسی</label>
                                    <input type="text" class="form-control form-control-sm" id="prop_label_fa">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">نام انگلیسی</label>
                                    <input type="text" class="form-control form-control-sm" id="prop_label_en" dir="ltr">
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="prop_readonly">
                                        <label class="form-check-label small" for="prop_readonly">فقط خواندنی (Read-only)</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="prop_disabled">
                                        <label class="form-check-label small" for="prop_disabled">غیرفعال (Disabled)</label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Section 2: Font Styles (Bordered) -->
                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="float-none w-auto px-2 fs-6 fw-bold text-primary">استایل فونت</legend>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small">نام فونت</label>
                                    <select class="form-select form-select-sm" id="prop_font_family">
                                        <option value="inherit">پیش‌فرض</option>
                                        <option value="IRANSans">ایران سنس</option>
                                        <option value="Vazirmatn">وزیر متن</option>
                                        <option value="Yekan">یکان</option>
                                        <option value="Tahoma">Tahoma</option>
                                        <option value="Arial">Arial</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">اندازه فونت</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control" id="prop_font_size" value="14" min="8" max="72">
                                        <span class="input-group-text">px</span>
