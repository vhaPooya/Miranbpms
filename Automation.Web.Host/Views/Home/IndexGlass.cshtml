@{
    ViewData["Title"] = "خانه";
    Layout = "_LayoutGlass";
}

<div class="main-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; align-items: start;">
    <div class="column-stack" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card grad-blue-cyan" style="flex: 1;">
            <div class="card-header">
                <i class="fa-solid fa-ellipsis-vertical dots-menu" style="cursor: pointer; opacity: 0.7;"></i>
                <div>
                    <div class="card-title">کارتابل جاری</div>
                    <i class="fa-solid fa-book-open" style="font-size:1.5rem; opacity:0.5; position:absolute; left:0; top:5px;"></i>
                </div>
            </div>
            
            <div class="cartable-row" style="background: rgba(255,255,255,0.03); margin-bottom: 8px; padding: 12px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.05);">
                <span>نامه‌های خوانده نشده</span>
                <span class="status-badge" style="width: 8px; height: 8px; border-radius: 50%; box-shadow: 0 0 5px currentColor; background:#10b981; color:#10b981"></span>
            </div>
            <div class="cartable-row" style="background: rgba(255,255,255,0.03); margin-bottom: 8px; padding: 12px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.05);">
                <span>ارجاعات فوری</span>
                <span class="status-badge" style="width: 8px; height: 8px; border-radius: 50%; box-shadow: 0 0 5px currentColor; background:#f59e0b; color:#f59e0b"></span>
            </div>
            <div class="cartable-row" style="background: rgba(255,255,255,0.03); margin-bottom: 8px; padding: 12px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.05);">
                <span>منتظر تایید مدیریت</span>
                <span class="status-badge" style="width: 8px; height: 8px; border-radius: 50%; box-shadow: 0 0 5px currentColor; background:#ef4444; color:#ef4444"></span>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-ellipsis-vertical dots-menu" style="cursor: pointer; opacity: 0.7;"></i>
                <div class="card-title">گفتگوی سریع</div>
            </div>
            <div style="position: relative; margin-top: auto;">
                <input type="text" class="chat-inp" placeholder="پیام خود را بنویسید..." style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; padding: 10px; color: white; padding-left: 35px;">
                <i class="fa-solid fa-paper-plane chat-send" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #3b82f6;"></i>
            </div>
        </div>
    </div>

    <div class="column-stack" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-ellipsis-vertical dots-menu" style="cursor: pointer; opacity: 0.7;"></i>
                <div class="card-title">وظایف امروز</div>
            </div>
            <div class="task-row" style="display: flex; align-items: center; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 10px; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.05);">
                <div class="check-circle" style="width: 18px; height: 18px; border: 2px solid #10b981; border-radius: 5px; margin-left: 10px; display: flex; align-items: center; justify-content: center; background: #10b981; color: white; font-size: 10px;"><i class="fa-solid fa-check"></i></div>
                <span style="margin-right:10px">بررسی قراردادها</span>
            </div>
            <div class="task-row" style="display: flex; align-items: center; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 10px; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.05); opacity: 0.6;">
                <div class="check-circle empty" style="width: 18px; height: 18px; border: 2px solid #64748b; border-radius: 5px; margin-left: 10px; display: flex; align-items: center; justify-content: center; background: transparent;"></div>
                <span style="margin-right:10px">جلسه با تیم فنی</span>
            </div>
        </div>

        <div class="card grad-purple" style="flex: 1; text-align: center; justify-content: center;">
            <i class="fa-solid fa-bullhorn" style="font-size: 3rem; margin-bottom: 20px; color: rgba(255,255,255,0.9);"></i>
            <div class="card-title">اطلاعیه مهم</div>
            <p class="card-desc" style="color: rgba(255,255,255,0.9);">
                جلسه عمومی پایان سال روز چهارشنبه برگزار می‌گردد.
            </p>
        </div>
    </div>

    <div class="column-stack" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card">
            <div class="card-header">
                <div class="card-title">عملکرد ماهانه</div>
                <i class="fa-solid fa-chart-pie" style="color:#f59e0b; font-size:1.2rem;"></i>
            </div>
            <div class="chart-wrapper" style="height: 160px; display: flex; align-items: center; justify-content: center;">
                <div class="donut" style="width: 110px; height: 110px; border-radius: 50%; background: conic-gradient(#3b82f6 0% 35%, #f59e0b 35% 55%, #ef4444 55% 80%, #8b5cf6 80% 100%); position: relative; display: flex; align-items: center; justify-content: center;">
                    <div style="content: ''; width: 70px; height: 70px; background-color: #1a2030; border-radius: 50%; position: absolute;"></div>
                </div>
            </div>
        </div>

        <div class="card grad-blue-solid" style="flex: 1;">
            <div class="card-header">
                <div>
                    <div class="card-title">اخبار سیستم</div>
                    <p class="card-desc" style="color: rgba(255,255,255,0.8); margin-top:5px;">
                        نسخه جدید اتوماسیون با موفقیت آپدیت شد.
                    </p>
                </div>
                <i class="fa-regular fa-newspaper" style="font-size:2rem; opacity:0.8;"></i>
            </div>
        </div>
    </div>

    <div class="column-stack" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card grad-blue-cyan">
            <div class="card-header">
                <i class="fa-solid fa-ellipsis-vertical dots-menu" style="cursor: pointer; opacity: 0.7;"></i>
                <div class="card-title">وضعیت سرور</div>
                <i class="fa-solid fa-server" style="font-size:1.2rem; opacity:0.7"></i>
            </div>
            <p class="card-desc">همه سرویس‌ها آنلاین هستند.</p>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-ellipsis-vertical dots-menu" style="cursor: pointer; opacity: 0.7;"></i>
                <div class="card-title">دیتابیس</div>
                <i class="fa-solid fa-database" style="color: #60a5fa;"></i>
            </div>
            <div style="background:rgba(255,255,255,0.05); padding:10px; border-radius:8px; text-align:center;">
                <span style="font-size:0.9rem;">بک‌آپ گیری خودکار</span>
                <br>
                <small style="opacity:0.5; font-size: 0.7rem;">آخرین: ۲ ساعت پیش</small>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-ellipsis-vertical dots-menu" style="cursor: pointer; opacity: 0.7;"></i>
                <div class="card-title">تقویم کاری</div>
                <i class="fa-regular fa-calendar-days" style="opacity:0.7"></i>
            </div>
            <div class="cal-nav" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 10px; margin-top: 10px; border: 1px solid rgba(255,255,255,0.1);">
                <i class="fa-solid fa-chevron-right" style="cursor:pointer"></i>
                <span style="font-size:0.9rem">۳ آذر ۱۴۰۴</span>
                <i class="fa-solid fa-chevron-left" style="cursor:pointer"></i>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 1200px) {
        .main-grid {
            grid-template-columns: repeat(2, 1fr) !important;
        }
    }
    @@media (max-width: 768px) {
        .main-grid {
            grid-template-columns: 1fr !important;
        }
    }
</style>

