<div class="tab-content" id="myTabContent">

    <div class="tab-pane fade show active" id="manage-pane" role="tabpanel">
        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-lg-6">
                <div class="card h-100 border-0 custom-shadow rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h6 class="fw-bold m-0">کارتابل جاری</h6>
                            <i class="fa-solid fa-ellipsis-vertical text-muted cursor-pointer"></i>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between bg-light list-item p-2 rounded"><span>کارتابل جاری</span><span class="status-dot bg-success"></span></div>
                            <div class="d-flex justify-content-between bg-light list-item p-2 rounded"><span>کارتابل برگزاری</span><span class="status-dot bg-warning"></span></div>
                            <div class="d-flex justify-content-between bg-light list-item p-2 rounded"><span>مدیریت منابع</span><span class="status-dot bg-warning"></span></div>
                            <div class="d-flex justify-content-between bg-light list-item p-2 rounded"><span>دبیرخانه مرکزی</span><span class="status-dot bg-danger"></span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6">
                <div class="card h-100 border-0 custom-shadow rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h6 class="fw-bold m-0">وظایف امروز</h6>
                            <i class="fa-solid fa-ellipsis-vertical text-muted cursor-pointer"></i>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="bg-light list-item p-2 rounded d-flex align-items-center">
                                <i class="fa-solid fa-check text-success ms-2"></i> ثبت نامه‌های وارده
                            </div>
                            <div class="bg-light list-item p-2 rounded d-flex align-items-center opacity-50">
                                <i class="fa-regular fa-square ms-2"></i> بررسی مرسولات
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6">
                <div class="card h-100 border-0 custom-shadow rounded-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h6 class="fw-bold m-0">آمار نامه‌ها</h6>
                            <i class="fa-solid fa-chart-pie text-warning"></i>
                        </div>
                        <div class="donut-chart">
                            <div class="donut-inner"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card border-0 custom-shadow rounded-4 bg-gradient-blue text-white flex-grow-1">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <div class="d-flex justify-content-between mb-2">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                                <i class="fa-regular fa-envelope fs-5"></i>
                            </div>
                            <h6 class="m-0">نامه‌های پاسخ داده نشده</h6>
                        </div>
                    </div>
                    <div class="card border-0 custom-shadow rounded-4 bg-left-border flex-grow-1">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <div class="d-flex justify-content-between mb-2">
                                <i class="fa-solid fa-ellipsis-vertical text-muted"></i>
                                <i class="fa-solid fa-envelope text-primary fs-5"></i>
                            </div>
                            <h6 class="m-0 text-dark">ایمیل‌های مشاهده نشده</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-9">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card card-hoverable h-100 p-3 bg-white" data-bs-toggle="modal" data-bs-target="#incomingModal">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1">ثبت وارده</h6>
                                    <small class="text-muted">ثبت نامه‌های دریافتی</small>
                                </div>
                                <i class="fa-solid fa-file-import fs-2 text-primary opacity-75"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card card-hoverable h-100 p-3 bg-white" data-bs-toggle="modal" data-bs-target="#outgoingModal">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1">ثبت صادره</h6>
                                    <small class="text-muted">ثبت و صدور نامه</small>
                                </div>
                                <i class="fa-solid fa-file-export fs-2 text-primary opacity-75" style="color: var(--brand-purple) !important;"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card card-hoverable h-100 p-3 bg-white">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1">جستجوی اسناد</h6>
                                    <small class="text-muted">جستجوی پیشرفته</small>
                                </div>
                                <i class="fa-solid fa-magnifying-glass-arrow-right fs-2 text-primary opacity-75"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card card-hoverable h-100 p-3 bg-white">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1">پیش‌نویس وارده</h6>
                                    <small class="text-muted">مدیریت پیش‌نویس‌ها</small>
                                </div>
                                <i class="fa-solid fa-file-pen fs-2 text-info opacity-75"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card card-hoverable h-100 p-3 bg-white">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1">شماره رزرو</h6>
                                    <small class="text-muted">مدیریت شماره‌ها</small>
                                </div>
                                <i class="fa-solid fa-list-ol fs-2 text-warning opacity-75"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card card-hoverable h-100 p-3 bg-white">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1">درخواست صادره</h6>
                                    <small class="text-muted">درخواست صدور نامه</small>
                                </div>
                                <i class="fa-solid fa-envelope-open-text fs-2 text-primary opacity-75" style="color: var(--brand-purple) !important;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card border-0 custom-shadow rounded-4 h-100">
                    <div class="card-body">
                        <h6 class="fw-bold border-bottom pb-3 mb-3">
                            <i class="fa-solid fa-sliders ms-2 text-primary"></i>
                            ثبت پیش‌فرض‌ها
                        </h6>
                        <div class="d-flex flex-column gap-2">
                            <a href="#" class="d-flex justify-content-between align-items-center p-2 rounded bg-light list-btn">
                                <small>موضوعات اسناد</small>
                                <i class="fa-solid fa-chevron-left text-muted" style="font-size:0.7rem"></i>
                            </a>
                            <a href="#" class="d-flex justify-content-between align-items-center p-2 rounded bg-light list-btn">
                                <small>اسامی سازمان‌ها</small>
                                <i class="fa-solid fa-chevron-left text-muted" style="font-size:0.7rem"></i>
                            </a>
                            <a href="#" class="d-flex justify-content-between align-items-center p-2 rounded bg-light list-btn">
                                <small>توضیحات پیش‌فرض</small>
                                <i class="fa-solid fa-chevron-left text-muted" style="font-size:0.7rem"></i>
                            </a>
                            <a href="#" class="d-flex justify-content-between align-items-center p-2 rounded bg-light list-btn">
                                <small>موضوعات پرتکرار</small>
                                <i class="fa-solid fa-chevron-left text-muted" style="font-size:0.7rem"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="search-pane" role="tabpanel">

        <div class="card border-0 custom-shadow rounded-4 mb-4 search-card">
            <div class="card-body p-4">
                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">
                    <i class="fa-solid fa-filter me-2 text-primary"></i>پارامترهای جستجو
                </h6>

                <div class="row g-3 justify-content-center mb-3">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label-sm">نوع مدرک</label>
                        <select class="form-select form-select-sm" id="docType" onchange="showCriteria()">
                            <option value="" selected disabled>انتخاب کنید...</option>
                            <option>سربرگ</option>
                            <option>مرخصی روزانه</option>
                            <option>ماموریت روزانه</option>
                            <option>درخواست کالا</option>
                            <option>صورتجلسه</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 justify-content-center align-items-end d-none-custom animate-fade-in" id="row-criteria">

                    <div class="col-md-4 col-lg-3">
                        <label class="form-label-sm">جستجو براساس</label>
                        <select class="form-select form-select-sm" id="searchCriteria" onchange="toggleFields()">
                            <option value="" selected disabled>انتخاب کنید...</option>
                            <option value="subject">موضوع / متن نامه</option>
                            <option value="date">تاریخ مدرک</option>
                            <option value="daterange">بازه ای از تاریخ</option>
                            <option value="user">فرستنده / گیرنده</option>
                            <option value="number">شماره (صادره/وارده/داخلی)</option>
                        </select>
                    </div>

                    <div class="col-md-6 col-lg-4">

                        <div id="field-subject" class="d-none-custom animate-fade-in">
                            <label class="form-label-sm">عبارت جستجو</label>
                            <input type="text" class="form-control form-control-sm" placeholder="بخشی از متن...">
                        </div>

                        <div id="field-date" class="d-none-custom animate-fade-in">
                            <label class="form-label-sm">تاریخ مدرک</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" placeholder="۱۴۰۴/۰۱/۰۱">
                                <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                            </div>
                        </div>

                        <div id="field-daterange" class="d-none-custom animate-fade-in">
                            <div class="d-flex gap-2">
                                <div class="flex-grow-1">
                                    <label class="form-label-sm">از تاریخ</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control">
                                        <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <label class="form-label-sm">تا تاریخ</label>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control">
                                        <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="field-user" class="d-none-custom animate-fade-in">
                            <label class="form-label-sm">طرف مکاتبه</label>
                            <div class="input-group input-group-sm cursor-pointer" onclick="openUserSelectModal()">
                                <input type="text" id="userInput" class="form-control bg-white" placeholder="انتخاب کنید..." readonly>
                                <span class="input-group-text"><i class="fa-solid fa-user-tag"></i></span>
                            </div>
                        </div>

                        <div id="field-number" class="d-none-custom animate-fade-in">
                            <label class="form-label-sm">شماره مدرک</label>
                            <input type="text" class="form-control form-control-sm" placeholder="شماره...">
                        </div>
                    </div>

                    <div class="col-md-2 d-none-custom animate-fade-in" id="row-search-btn">
                        <button class="btn btn-primary btn-sm w-100">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> جستجو
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="card border-0 custom-shadow rounded-4">
            <div class="card-body p-0">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white rounded-top-4">
                    <h6 class="m-0 fw-bold text-dark">نتیجه جستجو</h6>
                    <span class="badge bg-light text-secondary border rounded-pill">۵ مورد یافت شد</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width:50px">ردیف</th>
                                <th>تاریخ مدرک</th>
                                <th>فرستنده / گیرنده</th>
                                <th>موضوع</th>
                                <th>شماره</th>
                                <th class="text-center" style="width:100px">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">۱</td>
                                <td>۱۴۰۴/۰۲/۱۵</td>
                                <td>شرکت ملی گاز</td>
                                <td class="fw-bold text-dark">درخواست انشعاب جدید فاز ۲</td>
                                <td>۹۹/۵۱۱۲</td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa-solid fa-ellipsis-vertical text-muted"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                            <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                            <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-pen me-2"></i>ویرایش</a></li>
                                            <li><a class="dropdown-item small" href="#"><i class="fa-solid fa-print me-2"></i>چاپ</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center">2</td>
                                <td>۱۴۰۴/۰۲/۱8</td>
                                <td>واحد منابع انسانی</td>
                                <td class="fw-bold text-dark">احکام سال جدید</td>
                                <td>1404/HR/20</td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical text-muted"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 fs-7">
                                            <li><a class="dropdown-item small" href="#"><i class="fa-regular fa-eye me-2"></i>مشاهده</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="email-pane" role="tabpanel">
        <div class="card border-0 custom-shadow rounded-4 p-5 text-center text-muted">
            <i class="fa-regular fa-envelope-open display-4 mb-3"></i>
            <h4>صندوق ایمیل</h4>
        </div>
    </div>
</div>
